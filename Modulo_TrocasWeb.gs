/**
 * MÓDULO BRIGADA 1.0 — Modulo_TrocasWeb.gs
 * Aplicativo web da Central de trocas (visual Material Design verde, igual ao SiRAlt).
 * O militar abre o link no celular, escolhe data/escala/quem sai/quem entra e envia; o S/1 entra na aba "Administração - S/1" com o código
 * de autorização e decide. Tudo usa a aba "Central de trocas" e a regra de Modulo_Trocas.gs.
 * Publicar: Implantar → Nova implantação → App da Web → Executar como: você · Quem tem acesso: qualquer pessoa (ou só o domínio).
 * Depois de mudar o código, use Implantar → Gerenciar implantações → Editar → Nova versão.
 */

var HTML_TROCAS_WEB_ = "<!DOCTYPE html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>Central de Trocas</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block\" rel=\"stylesheet\">\n<style>\n:root{color-scheme:light dark;--p:#3A6A35;--onp:#fff;--pc:#BBF0AE;--onpc:#002201;--sc:#D7E8CD;--onsc:#121F0E;--er:#BA1A1A;--erc:#FFDAD6;--oner:#410002;--s:#F8FAF0;--sl:#F2F5EB;--sm:#ECEFE5;--sh:#E6E9DF;--on:#191D17;--onv:#43483F;--ol:#73796E;--olv:#C3C8BB;--wa:#FFE9B5;--onwa:#3B2A00;--font:'Roboto',system-ui,-apple-system,'Segoe UI',sans-serif}\n@media(prefers-color-scheme:dark){:root{--p:#A0D494;--onp:#063909;--pc:#215023;--onpc:#BBF0AE;--sc:#3C4B37;--onsc:#D7E8CD;--er:#FFB4AB;--erc:#93000A;--oner:#FFDAD6;--s:#11140F;--sl:#191D17;--sm:#1D211B;--sh:#272B25;--on:#E1E4DA;--onv:#C3C8BB;--ol:#8D9387;--olv:#43483F;--wa:#4A3A00;--onwa:#FFE9B5}}\n*{box-sizing:border-box}html,body{margin:0;width:100%;max-width:100vw;overflow-x:hidden}\nbody{background:var(--s);color:var(--on);font:400 16px/24px var(--font);letter-spacing:.3px;-webkit-font-smoothing:antialiased;padding-bottom:88px}\n.icon{font-family:'Material Symbols Outlined';font-weight:400;font-style:normal;font-size:24px;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;direction:ltr;font-feature-settings:'liga';user-select:none;flex:none}\n.bar{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:16px;min-height:64px;padding:8px 16px;background:var(--sm);border-bottom:1px solid var(--olv)}\n.bar .ai{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--pc);color:var(--onpc)}\n.bar h1{margin:0;font:400 20px/26px var(--font);letter-spacing:0}.bar .sub{font:500 12px/16px var(--font);color:var(--onv)}\n.bar .t{flex:1;min-width:0}\n.prog{position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--sh)}.prog i{display:block;height:100%;width:0;background:var(--p);transition:width .25s}\n.wrap{max-width:720px;margin:0 auto;padding:16px}\n.card{background:var(--sl);border:1px solid var(--olv);border-radius:16px;padding:16px;margin:0 0 16px}\n.ch{display:flex;align-items:center;gap:12px;margin-bottom:12px}\n.ib{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--pc);color:var(--onpc)}\n.ct{font:500 16px/24px var(--font);margin:0}.cs{font:400 12px/16px var(--font);color:var(--onv)}\n.stp{display:flex;align-items:center;gap:8px;margin:0 0 12px}.sc{font:500 12px/16px var(--font);color:var(--p);text-transform:uppercase;letter-spacing:.6px}.sn{font:400 14px/20px var(--font);color:var(--onv)}\n.f{position:relative;margin-bottom:16px}\n.f select,.f input,.f textarea{width:100%;font:400 16px/24px var(--font);color:var(--on);background:transparent;border:1px solid var(--ol);border-radius:4px;padding:16px 14px 8px;outline:none;appearance:none;-webkit-appearance:none;min-height:56px}\n.f textarea{min-height:88px;resize:vertical}\n.f select{background-image:linear-gradient(45deg,transparent 50%,var(--onv) 50%),linear-gradient(135deg,var(--onv) 50%,transparent 50%);background-position:calc(100% - 20px) 26px,calc(100% - 14px) 26px;background-size:6px 6px;background-repeat:no-repeat;padding-right:36px}\n.f select option{background:var(--sl);color:var(--on)}\n.f label{position:absolute;left:12px;top:4px;padding:0 4px;background:var(--sl);font:400 12px/16px var(--font);color:var(--onv);pointer-events:none}\n.f select:focus,.f input:focus,.f textarea:focus{border-color:var(--p);box-shadow:inset 0 0 0 1px var(--p)}\n.f:focus-within label{color:var(--p)}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border:0;border-radius:22px;font:500 14px/20px var(--font);letter-spacing:.1px;cursor:pointer;background:var(--sc);color:var(--onsc)}\n.btn.fill{background:var(--p);color:var(--onp)}.btn.out{background:transparent;color:var(--p);border:1px solid var(--ol)}.btn.err{background:var(--erc);color:var(--oner)}\n.btn[disabled]{opacity:.45;cursor:not-allowed}.btn .icon{font-size:20px}\n.nav{display:flex;gap:8px;justify-content:space-between;margin-top:8px}\n.opts{display:flex;flex-direction:column;gap:8px}\n.opt{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--olv);border-radius:12px;background:var(--s);cursor:pointer}\n.opt input{accent-color:var(--p);width:20px;height:20px;margin:0}\n.opt.sel{border-color:var(--p);background:var(--pc);color:var(--onpc)}\n.opt .n{flex:1;min-width:0}.opt .n b{font-weight:500}.opt .n small{display:block;color:var(--onv);font-size:12px;line-height:16px}.opt.sel .n small{color:var(--onpc)}\n.tg{display:inline-flex;align-items:center;gap:4px;padding:0 8px;border-radius:8px;font:500 11px/20px var(--font)}\n.tg.ok{background:var(--pc);color:var(--onpc)}.tg.al{background:var(--wa);color:var(--onwa)}\n.ban{display:flex;gap:12px;align-items:flex-start;padding:12px 16px;border-radius:12px;margin:0 0 16px;font:400 14px/20px var(--font)}\n.ban.ok{background:var(--pc);color:var(--onpc)}.ban.er{background:var(--erc);color:var(--oner)}.ban.wa{background:var(--wa);color:var(--onwa)}.ban.in{background:var(--sc);color:var(--onsc)}\n.mu{color:var(--onv);font-size:12px;line-height:16px}\n.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:520px){.row{grid-template-columns:1fr}}\n.sum{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:14px;line-height:20px}.sum dt{color:var(--onv)}.sum dd{margin:0;font-weight:500}\n.pill{display:inline-block;padding:0 10px;border-radius:12px;font:500 12px/22px var(--font)}\n.pill.Pendente{background:var(--wa);color:var(--onwa)}.pill.Autorizada{background:var(--pc);color:var(--onpc)}.pill.Negada,.pill.Inválida{background:var(--erc);color:var(--oner)}.pill.Cancelada{background:var(--sh);color:var(--onv)}\n.req{border:1px solid var(--olv);border-radius:12px;padding:12px 14px;margin:0 0 12px;background:var(--s)}\n.req .h{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px;flex-wrap:wrap}\n.req .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.req .acts .btn{height:40px}\n.bn{position:fixed;left:0;right:0;bottom:0;z-index:60;display:flex;background:var(--sm);border-top:1px solid var(--olv);padding:8px 8px calc(8px + env(safe-area-inset-bottom))}\n.bn button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;border:0;background:transparent;color:var(--onv);font:500 12px/16px var(--font);cursor:pointer;padding:4px 0}\n.bn button .icon{width:56px;height:32px;display:grid;place-items:center;border-radius:16px}\n.bn button.on{color:var(--on)}.bn button.on .icon{background:var(--pc);color:var(--onpc)}\n.hide{display:none!important}\n.sp{display:inline-block;width:18px;height:18px;border:3px solid var(--olv);border-top-color:var(--p);border-radius:50%;animation:g .8s linear infinite;vertical-align:middle}@keyframes g{to{transform:rotate(360deg)}}\n.empty{text-align:center;color:var(--onv);padding:24px 8px}\n</style></head><body>\n<header class=\"bar\"><span class=\"ai\"><span class=\"icon\">swap_horiz</span></span><div class=\"t\"><h1>Central de Trocas de Serviço</h1><div class=\"sub\">21º GAC · Grupo Monte Bastos</div></div><div class=\"prog\"><i id=\"pg\"></i></div></header>\n<main class=\"wrap\">\n<div id=\"msg\"></div>\n\n<!-- SOLICITAR -->\n<section id=\"v-sol\">\n <div class=\"stp\"><span class=\"sc\" id=\"stc\">Etapa 1 de 3</span><span class=\"sn\" id=\"stn\">Serviço</span></div>\n\n <div class=\"card\" id=\"s1\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">event</span></span><div><h2 class=\"ct\">Qual serviço?</h2><div class=\"cs\">Escolha a data e a escala</div></div></div>\n  <div class=\"f\"><input type=\"date\" id=\"data\"><label for=\"data\">Data do serviço</label></div>\n  <div class=\"f\"><select id=\"esc\"></select><label for=\"esc\">Escala</label></div>\n  <div class=\"nav\"><span></span><button class=\"btn fill\" id=\"b1\" onclick=\"vaiDia()\">Avançar<span class=\"icon\">arrow_forward</span></button></div>\n </div>\n\n <div class=\"card hide\" id=\"s2\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">groups</span></span><div><h2 class=\"ct\">Quem sai e quem pega</h2><div class=\"cs\" id=\"s2sub\"></div></div></div>\n  <div class=\"mu\" style=\"margin-bottom:6px\">Quem está escalado (sai)</div><div class=\"opts\" id=\"lsai\"></div>\n  <div class=\"mu\" style=\"margin:16px 0 6px\">Quem vai pegar o serviço (entra)</div>\n  <div class=\"f\" style=\"margin-bottom:8px\"><input type=\"search\" id=\"busca\" placeholder=\" \" oninput=\"pintaEntra()\"><label for=\"busca\">Buscar militar</label></div>\n  <div class=\"opts\" id=\"lentra\"></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"passo(1)\"><span class=\"icon\">arrow_back</span>Voltar</button><button class=\"btn fill\" id=\"b2\" onclick=\"vaiRev()\">Avançar<span class=\"icon\">arrow_forward</span></button></div>\n </div>\n\n <div class=\"card hide\" id=\"s3\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">fact_check</span></span><div><h2 class=\"ct\">Conferir e enviar</h2><div class=\"cs\">O S/1 vai autorizar ou negar</div></div></div>\n  <dl class=\"sum\" id=\"rev\"></dl>\n  <div id=\"rav\"></div>\n  <div class=\"f\" style=\"margin-top:16px\"><input type=\"text\" id=\"sol\"><label for=\"sol\">Pedido feito por</label></div>\n  <div class=\"f\"><textarea id=\"mot\" maxlength=\"300\"></textarea><label for=\"mot\">Motivo (opcional)</label></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"passo(2)\"><span class=\"icon\">arrow_back</span>Voltar</button><button class=\"btn fill\" id=\"b3\" onclick=\"envia()\"><span class=\"icon\">send</span>Enviar pedido</button></div>\n </div>\n\n <div class=\"card hide\" id=\"s4\">\n  <div class=\"ban ok\"><span class=\"icon\">check_circle</span><div><b>Pedido enviado</b><div id=\"okid\"></div></div></div>\n  <p class=\"mu\">Guarde o número do pedido. Em <b>Acompanhar</b> você vê quando o S/1 decidir.</p>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"aba('seg')\"><span class=\"icon\">list_alt</span>Acompanhar</button><button class=\"btn fill\" onclick=\"novo()\"><span class=\"icon\">add</span>Novo pedido</button></div>\n </div>\n</section>\n\n<!-- ACOMPANHAR -->\n<section id=\"v-seg\" class=\"hide\">\n <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">list_alt</span></span><div><h2 class=\"ct\">Meus pedidos</h2><div class=\"cs\">Pedidos feitos neste aparelho</div></div></div>\n <div id=\"lseg\"></div>\n <div class=\"nav\"><span></span><button class=\"btn out\" onclick=\"carregaSeg()\"><span class=\"icon\">refresh</span>Atualizar</button></div></div>\n</section>\n\n<!-- AUTORIZAR -->\n<section id=\"v-aut\" class=\"hide\">\n <div class=\"card\" id=\"login\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">lock</span></span><div><h2 class=\"ct\">Administração - S/1</h2><div class=\"cs\">Informe o código de acesso</div></div></div>\n  <div class=\"f\"><input type=\"text\" id=\"an\" autocomplete=\"name\"><label for=\"an\">Seu nome (posto e nome de guerra)</label></div>\n  <div class=\"f\"><input type=\"password\" id=\"pin\" autocomplete=\"current-password\" inputmode=\"text\"><label for=\"pin\">Código de acesso</label></div>\n  <div class=\"nav\"><span></span><button class=\"btn fill\" onclick=\"entrar()\"><span class=\"icon\">login</span>Entrar</button></div>\n </div>\n <div id=\"painel\" class=\"hide\">\n  <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">pending_actions</span></span><div><h2 class=\"ct\">Pedidos pendentes</h2><div class=\"cs\" id=\"psub\"></div></div></div><div id=\"lpend\"></div></div>\n  <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">history</span></span><div><h2 class=\"ct\">Autorizadas recentemente</h2><div class=\"cs\">Pode cancelar uma troca já autorizada</div></div></div><div id=\"laut\"></div></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"sair()\"><span class=\"icon\">logout</span>Sair</button><button class=\"btn out\" onclick=\"carregaAut()\"><span class=\"icon\">refresh</span>Atualizar</button></div>\n </div>\n</section>\n</main>\n\n<nav class=\"bn\"><button id=\"n-sol\" class=\"on\" onclick=\"aba('sol')\"><span class=\"icon\">swap_horiz</span>Solicitar</button><button id=\"n-seg\" onclick=\"aba('seg')\"><span class=\"icon\">list_alt</span>Acompanhar</button><button id=\"n-aut\" onclick=\"aba('aut')\"><span class=\"icon\">verified_user</span>Administração</button></nav>\n\n<script>\nvar $=function(i){return document.getElementById(i)};\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction run(fn,args,ok,er){var r=google.script.run.withSuccessHandler(ok).withFailureHandler(function(e){er?er(e):aviso('er',(e&&e.message)||String(e))});r[fn].apply(r,args)}\nfunction aviso(t,m){var i={ok:'check_circle',er:'error',wa:'warning',in:'info'}[t];$('msg').innerHTML=m?'<div class=\"ban '+t+'\" role=\"alert\"><span class=\"icon\">'+i+'</span><div>'+m+'</div></div>':'';if(m)window.scrollTo(0,0)}\nfunction ls(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}\nvar S={ini:null,sel:null,dia:null,sai:null,entra:null,tab:'sol',pin:'',quem:''},PG=[0,33,66,100];\n\nfunction aba(t){S.tab=t;aviso('',''); ['sol','seg','aut'].forEach(function(x){$('v-'+x).classList.toggle('hide',x!==t);$('n-'+x).classList.toggle('on',x===t)});\n if(t==='seg')carregaSeg(); if(t==='aut'&&S.pin)carregaAut(); if(t==='sol')$('pg').style.width=PG[S.step||1]+'%'; else $('pg').style.width='0'}\nS.step=1;\nfunction passo(n){S.step=n;aviso('','');['s1','s2','s3','s4'].forEach(function(x,i){$(x).classList.toggle('hide',i+1!==n)});\n $('stc').textContent=n<4?'Etapa '+n+' de 3':'Concluído';$('stn').textContent=['','Serviço','Militares','Conferência','Enviado'][n];$('pg').style.width=PG[Math.min(n,3)]+(n===4?'':'')+'%';if(n===4)$('pg').style.width='100%';window.scrollTo(0,0)}\n\n/* ---- início */\nfunction inicia(){ $('sol').value=ls('t_sol')||''; $('an').value=ls('t_an')||'';\n run('webInicio',[],function(r){S.ini=r;var d=$('data');d.min=r.hoje;d.max=r.fim;d.value='';fillEsc()},function(e){aviso('er',esc(e.message||e))});\n $('data').addEventListener('change',fillEsc)}\nfunction mesDe(iso){return iso?S.ini.meses.filter(function(m){return iso>=m.ini&&iso<=m.fim})[0]:null}\nfunction fillEsc(){var iso=$('data').value,m=mesDe(iso),s=$('esc'),h='';\n if(!S.ini){return}\n if(!iso){s.innerHTML='<option value=\"\">Escolha primeiro a data</option>';return}\n if(!m){s.innerHTML='<option value=\"\">Data fora das escalas disponíveis</option>';return}\n h='<option value=\"\">Selecione…</option>';m.escalas.forEach(function(e,i){h+='<option value=\"'+i+'\">'+esc(e.aba.replace(/^[^ ]+ /,'')+' · '+e.titulo)+'</option>'});s.innerHTML=h}\nfunction vaiDia(){aviso('','');var iso=$('data').value,m=mesDe(iso),i=$('esc').value;\n if(!iso)return aviso('er','Escolha a data do serviço.'); if(iso<S.ini.hoje)return aviso('er','A data já passou.');\n if(!m||i==='')return aviso('er','Escolha a escala.');\n var e=m.escalas[Number(i)];S.sel={mes:m.mes,tipo:e.tipo,hdr:e.hdr,titulo:e.titulo,aba:e.aba,iso:iso};\n var b=$('b1');b.disabled=true;b.innerHTML='<span class=\"sp\"></span> Carregando…';\n run('webDia',[S.sel.mes,S.sel.tipo,S.sel.hdr,iso],function(r){b.disabled=false;b.innerHTML='Avançar<span class=\"icon\">arrow_forward</span>';S.dia=r;S.sai=null;S.entra=null;\n  $('s2sub').textContent=r.data+' · '+e.titulo;$('busca').value='';pintaSai();pintaEntra();passo(2);\n  if(!r.sai.length)aviso('wa','Ninguém tem serviço (“0”) nessa escala nesse dia. Confira a data e a escala.')},\n  function(er){b.disabled=false;b.innerHTML='Avançar<span class=\"icon\">arrow_forward</span>';aviso('er',esc(er.message||er))})}\nfunction opt(nome,sub,sel,cb,tags){return '<label class=\"opt'+(sel?' sel':'')+'\"><input type=\"radio\" '+(sel?'checked ':'')+'onchange=\"'+cb+'\"><span class=\"n\"><b>'+esc(nome)+'</b>'+(sub?'<small>'+esc(sub)+'</small>':'')+'</span>'+(tags||'')+'</label>'}\nfunction pintaSai(){var h='';S.dia.sai.forEach(function(x,i){h+=opt(x.nome,x.sub,S.sai===i,'escSai('+i+')')});$('lsai').innerHTML=h||'<div class=\"empty\">Sem militares escalados.</div>'}\nfunction escSai(i){S.sai=i;if(S.entra!=null&&norm(S.dia.cands[S.entra].nome)===norm(S.dia.sai[i].nome))S.entra=null;pintaSai();pintaEntra()}\nfunction norm(s){return String(s).normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase().replace(/\\s+/g,' ').trim()}\nfunction pintaEntra(){var q=norm($('busca').value),h='',n=0;\n S.dia.cands.forEach(function(x,i){if(q&&norm(x.nome+' '+(x.sub||'')).indexOf(q)<0)return;n++;\n  var t=x.ok?'<span class=\"tg ok\"><span class=\"icon\" style=\"font-size:14px\">check</span>livre</span>':'<span class=\"tg al\" title=\"'+esc(x.flags.join('; '))+'\">atenção</span>';\n  h+=opt(x.nome,(x.sub||'')+(x.ok?'':(x.sub?' · ':'')+x.flags.join('; ')),S.entra===i,'escEntra('+i+')',t)});\n $('lentra').innerHTML=h||'<div class=\"empty\">Nenhum militar encontrado.</div>'}\nfunction escEntra(i){S.entra=i;pintaEntra()}\nfunction vaiRev(){aviso('','');if(S.sai==null)return aviso('er','Marque quem está escalado (sai).');if(S.entra==null)return aviso('er','Escolha quem vai pegar o serviço (entra).');\n var a=S.dia.sai[S.sai],b=S.dia.cands[S.entra];\n $('rev').innerHTML='<dt>Data</dt><dd>'+esc(S.dia.data)+'</dd><dt>Escala</dt><dd>'+esc(S.sel.titulo)+'<br><span class=\"mu\">'+esc(S.sel.aba)+'</span></dd><dt>Sai</dt><dd>'+esc(a.nome)+'</dd><dt>Entra</dt><dd>'+esc(b.nome)+'</dd>';\n $('rav').innerHTML=b.ok?'':'<div class=\"ban wa\" style=\"margin-top:12px\"><span class=\"icon\">warning</span><div>'+esc(b.nome)+': '+esc(b.flags.join('; '))+'. O S/1 verá esse alerta.</div></div>';\n if(!$('sol').value)$('sol').value=a.nome;passo(3)}\nfunction envia(){var nome=$('sol').value.trim();if(!nome)return aviso('er','Informe quem está fazendo o pedido.');\n var a=S.dia.sai[S.sai],b=S.dia.cands[S.entra],btn=$('b3');btn.disabled=true;btn.innerHTML='<span class=\"sp\"></span> Enviando…';\n run('webSolicitar',[{mes:S.sel.mes,tipo:S.sel.tipo,hdr:S.sel.hdr,titulo:S.sel.titulo,iso:S.sel.iso,sai:a.nome,entra:b.nome,solicitante:nome,motivo:$('mot').value.trim()}],function(r){\n  btn.disabled=false;btn.innerHTML='<span class=\"icon\">send</span>Enviar pedido';\n  if(r.situacao!=='Pendente')return aviso('er','Não foi possível registrar: '+esc(r.obs||'pedido inválido'));\n  ls('t_sol',nome);var ids=[];try{ids=JSON.parse(ls('t_ids')||'[]')}catch(e){}ids.unshift(r.id);ls('t_ids',JSON.stringify(ids.slice(0,30)));\n  $('okid').textContent='Número '+r.id+' · aguardando autorização do S/1.';passo(4)},\n  function(er){btn.disabled=false;btn.innerHTML='<span class=\"icon\">send</span>Enviar pedido';aviso('er',esc(er.message||er))})}\nfunction novo(){$('mot').value='';$('esc').value='';$('data').value='';fillEsc();S.sai=S.entra=null;passo(1)}\n\n/* ---- acompanhar */\nfunction cardReq(x,acts){return '<div class=\"req\"><div class=\"h\"><b>'+esc(x.id)+' · '+esc(x.data)+'</b><span class=\"pill '+esc(x.sit)+'\">'+esc(x.sit)+'</span></div><div>'+esc(x.esc)+'</div><div class=\"mu\">'+esc(x.aba)+'</div><div style=\"margin-top:6px\">Sai: <b>'+esc(x.sai)+'</b> → entra: <b>'+esc(x.entra)+'</b></div>'+(x.sol?'<div class=\"mu\">Pedido de '+esc(x.sol)+'</div>':'')+(x.mot?'<div class=\"mu\">Motivo: '+esc(x.mot)+'</div>':'')+(x.alert&&x.alert!=='Sem alertas'?'<div style=\"margin-top:6px\"><span class=\"tg al\">'+esc(x.alert)+'</span></div>':'')+(x.sit!=='Pendente'&&(x.por||x.obs)?'<div class=\"mu\" style=\"margin-top:6px\">'+(x.por?'Por '+esc(x.por):'')+(x.obs?' · '+esc(x.obs):'')+'</div>':'')+(acts||'')+'</div>'}\nfunction carregaSeg(){var ids=[];try{ids=JSON.parse(ls('t_ids')||'[]')}catch(e){}\n if(!ids.length){$('lseg').innerHTML='<div class=\"empty\">Nenhum pedido feito neste aparelho ainda.</div>';return}\n $('lseg').innerHTML='<div class=\"empty\"><span class=\"sp\"></span></div>';\n run('webStatus',[ids],function(r){$('lseg').innerHTML=r.length?r.map(function(x){return cardReq(x)}).join(''):'<div class=\"empty\">Nada encontrado.</div>'})}\n\n/* ---- autorizar */\nfunction entrar(){var p=$('pin').value,n=$('an').value.trim();if(!n)return aviso('er','Informe seu nome.');if(!p)return aviso('er','Informe o código.');\n run('webPendentes',[p],function(r){S.pin=p;S.quem=n;ls('t_an',n);$('pin').value='';$('login').classList.add('hide');$('painel').classList.remove('hide');aviso('','');pintaAut(r)})}\nfunction sair(){S.pin='';$('painel').classList.add('hide');$('login').classList.remove('hide')}\nfunction carregaAut(){run('webPendentes',[S.pin],pintaAut,function(e){sair();aviso('er',esc(e.message||e))})}\nfunction pintaAut(r){$('psub').textContent=r.pend.length?r.pend.length+' aguardando decisão':'Nenhum pedido pendente';\n $('lpend').innerHTML=r.pend.length?r.pend.map(function(x){return cardReq(x,'<div class=\"f\" style=\"margin:10px 0 0\"><input type=\"text\" id=\"o'+esc(x.id)+'\" placeholder=\" \"><label for=\"o'+esc(x.id)+'\">Observação (opcional)</label></div><div class=\"acts\"><button class=\"btn fill\" onclick=\"dec(\\''+esc(x.id)+'\\',\\'Autorizar\\')\"><span class=\"icon\">check</span>Autorizar</button><button class=\"btn err\" onclick=\"dec(\\''+esc(x.id)+'\\',\\'Negar\\')\"><span class=\"icon\">close</span>Negar</button></div>')}).join(''):'<div class=\"empty\">Tudo em dia.</div>';\n $('laut').innerHTML=r.aut.length?r.aut.map(function(x){return cardReq(x,'<div class=\"acts\"><button class=\"btn out\" onclick=\"dec(\\''+esc(x.id)+'\\',\\'Cancelar\\')\"><span class=\"icon\">undo</span>Cancelar troca</button></div>')}).join(''):'<div class=\"empty\">Nenhuma.</div>'}\nfunction dec(id,a){if(a==='Cancelar'&&!confirm('Cancelar a troca '+id+'? A anotação na escala será removida.'))return;\n var o=$('o'+id);run('webDecidir',[S.pin,id,a,o?o.value:'',S.quem],function(){aviso('ok','Pedido '+esc(id)+': '+(a==='Autorizar'?'autorizado e gravado na escala.':a==='Negar'?'negado.':'troca cancelada.'));carregaAut()})}\n\ninicia();passo(1);\n</script></body></html>\n";

function doGet() {
  return HtmlService.createHtmlOutput(HTML_TROCAS_WEB_)
    .setTitle('Central de Trocas')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function urlAppTrocas_() { try { return ScriptApp.getService().getUrl() || ''; } catch (e) { return ''; } }

/* ---------- código de autorização (só o hash fica guardado; 5 erros bloqueiam por 15 min) */
function hashPinTrocas_(pin) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, 'trocas-v1:' + String(pin), Utilities.Charset.UTF_8)
    .map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
}
function definirPinTrocas_(pin) {
  pin = String(pin || '');
  if (pin.length < 4) throw new Error('O código de autorização precisa ter pelo menos 4 caracteres.');
  PropertiesService.getDocumentProperties().setProperty('TROCAS_PIN', hashPinTrocas_(pin));
}
function conferirPinTrocas_(pin) {
  var p = PropertiesService.getDocumentProperties(), h = p.getProperty('TROCAS_PIN');
  if (!h) throw new Error('O código de autorização ainda não foi definido (menu Módulo Brigada → Confecção → Central de trocas → Configuração).');
  var e = JSON.parse(p.getProperty('TROCAS_PIN_ERR') || '{"n":0,"ate":0}'), agora = Date.now();
  if (e.ate > agora) throw new Error('Muitas tentativas. Tente de novo em ' + Math.ceil((e.ate - agora) / 60000) + ' min.');
  if (hashPinTrocas_(pin) !== h) {
    e.n = (e.n || 0) + 1;
    if (e.n >= 5) { e = { n: 0, ate: agora + 15 * 60000 }; }
    p.setProperty('TROCAS_PIN_ERR', JSON.stringify(e));
    throw new Error('Código incorreto.');
  }
  p.setProperty('TROCAS_PIN_ERR', '{"n":0,"ate":0}');
}

/* ---------- consultas e pedidos do aplicativo */
function webInicio() {
  var hoje = new Date(), tipos = [CFG.TIPO_GRAD, CFG.TIPO_CNDT], meses = [], fim = '';
  [0, 1].forEach(function (k) {
    var m = (hoje.getMonth() + k) % 12, mesId = CFG.MESES[m], r = apiBlocos(mesId, tipos);
    if (!r.blocos.length) return;
    meses.push({ mes: mesId, ini: r.ini, fim: r.fim, escalas: r.blocos.map(function (b) { return { aba: b.aba, tipo: b.tipo, hdr: b.hdr, titulo: b.titulo }; }) });
    fim = r.fim;
  });
  if (!meses.length) throw new Error('Nenhuma aba de escala do mês foi encontrada.');
  return { hoje: isoData_(hoje), fim: fim, meses: meses };
}

function webDia(mes, tipo, hdr, iso) {
  var i = apiTrocaInfo(mes, tipo, hdr, iso);
  return {
    data: i.data + ' ' + CFG.DIAS[parseIso_(iso).getDay()],
    sai: i.sai.map(function (x) { return { nome: x.nome, sub: x.sub || '' }; }),
    cands: i.cands.map(function (x) { return { nome: x.nome, sub: x.sub || '', ok: !!x.ok, flags: x.flags }; })
  };
}

function webSolicitar(p) {
  var nome = String(p.solicitante || '').replace(/\s+/g, ' ').trim().slice(0, 80);
  if (!nome) throw new Error('Informe quem está fazendo o pedido.');
  var lock = LockService.getDocumentLock();
  lock.waitLock(20000);
  try {
    return registrarTroca_({
      origem: 'Aplicativo', solicitante: nome, iso: String(p.iso || ''), tipo: String(p.tipo || ''), titulo: String(p.titulo || ''),
      sai: String(p.sai || ''), entra: String(p.entra || ''), motivo: String(p.motivo || '').slice(0, 300)
    });
  } finally { lock.releaseLock(); }
}

function itemTrocaWeb_(l) {
  var s = l[11] === 'Autorizar' || l[11] === 'Negar' ? 'Pendente' : l[11];
  return { id: l[0], rec: l[1] instanceof Date ? fmtData_(l[1]) : '', sol: l[3], data: l[4] instanceof Date ? fmtData_(l[4]) + ' ' + CFG.DIAS[l[4].getDay()] : '', aba: l[5], esc: l[6], sai: l[7], entra: l[8], mot: l[9], alert: l[10], sit: s, por: l[12], obs: l[14] };
}
function linhasTrocas_() {
  var sh = garantirCentral_();
  if (sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 15).getValues().filter(function (l) { return l[0]; });
}

/** status dos pedidos do próprio aparelho (só os números que ele guardou) */
function webStatus(ids) {
  var set = {};
  (ids || []).slice(0, 30).forEach(function (x) { set[String(x)] = true; });
  return linhasTrocas_().filter(function (l) { return set[String(l[0])]; }).map(itemTrocaWeb_).reverse();
}

function webPendentes(pin) {
  conferirPinTrocas_(pin);
  var todas = linhasTrocas_().map(itemTrocaWeb_).reverse();
  return {
    pend: todas.filter(function (x) { return x.sit === 'Pendente'; }),
    aut: todas.filter(function (x) { return x.sit === 'Autorizada'; }).slice(0, 15)
  };
}

function webDecidir(pin, id, acao, obs, quem) {
  conferirPinTrocas_(pin);
  var lock = LockService.getDocumentLock();
  lock.waitLock(20000);
  try { return decidirTroca_(String(id), String(acao), 'App: ' + String(quem || '').slice(0, 60), String(obs || '').slice(0, 200)); }
  finally { lock.releaseLock(); }
}
