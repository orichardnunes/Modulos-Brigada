:[]},n=e.pend+e.aut,ab=!!S.rx[t];\n  h+='<div class=\"rw\" '+(n?'onclick=\"resTog('+ix+')\"':'')+' style=\"'+(n?'':'cursor:default')+'\"><span class=\"nm\">'+esc(t)+'</span>'+(e.pend?'<span class=\"bd p\" title=\"pendentes\">'+e.pend+'</span>':'')+(e.aut?'<span class=\"bd a\" title=\"autorizadas\">'+e.aut+'</span>':'')+(!n?'<span class=\"bd z\">0</span>':'')+'<span class=\"icon\">'+(!n?'remove':(ab?'expand_more':(e.det?'chevron_right':'lock')))+'</span></div>';\n  if(ab&&n){h+='<div style=\"padding:0 0 8px\">';\n   if(!e.det)h+='<div class=\"ban in\" style=\"margin:0\"><span class=\"icon\">lock</span><div>Detalhes liberados só para a 1ª Seção e para quem é desta escala'+(r.visAtiva?' (escolha seu nome em “Sou o militar” e toque em “Ver detalhes da minha escala”)':' — o administrador ainda não liberou o acompanhamento de escalas')+'.</div></div>';\n   else h+=e.itens.map(function(x){return cardReq(x,'<div id=\"rv'+esc(x.id)+'\"></div><div class=\"acts\"><button class=\"btn out sm\" onclick=\"previaPub(\\''+esc(x.id)+'\\',this)\"><span class=\"icon\">visibility</span>Ver como fica</button></div>')}).join('');\n   h+='</div>'}});\n $('resL').innerHTML=h||'<div class=\"empty\">Nenhuma solicitação pendente ou autorizada.</div>'}\nfunction resTog(i){var t=S.ord[i];S.rx[t]=!S.rx[t];pintaRes()}\nfunction previaPub(id,b){b.disabled=true;run('webPreviaPub',[id,resMil(),S.tok||''],function(r){b.disabled=false;\n $('rv'+id).innerHTML='<div class=\"mu\" style=\"margin:10px 0 4px\">Como fica o dia — '+esc(r.esc)+' · '+esc(r.data)+'</div><div class=\"tw\"><table class=\"tbl\"><tr><th>Escalado</th><th>Depois da troca</th></tr>'+r.linhas.map(function(l){return '<tr style=\"'+(l.destaque?'background:var(--pc);color:var(--onpc);font-weight:500':'')+'\"><td>'+esc(l.sai)+'</td><td>'+(l.dep?'➜ '+esc(l.dep)+' *':'sem troca')+(l.destaque&&l.antes?'<div class=\"mu\" style=\"color:inherit\">antes: '+esc(l.antes)+'</div>':'')+'</td></tr>'}).join('')+'</table></div>'},function(e){b.disabled=fa