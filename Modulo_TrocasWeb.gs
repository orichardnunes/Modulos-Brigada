ge||e))})}\n\n/* ---- ajuda, aparência, tour */\nfunction temaAtual(){return ls('t_tema')||'auto'}\nfunction aplicaTema(t){var r=document.documentElement;if(t==='auto')r.removeAttribute('data-tema');else r.setAttribute('data-tema',t);ls('t_tema',t)}\nfunction aplicaZoom(z){document.documentElement.style.setProperty('--zoom',z);ls('t_zoom',z)}\nfunction seg(id,opts,cur,fn){$(id).innerHTML=opts.map(function(o){return '<button class=\"'+(String(o[0])===String(cur)?'on':'')+'\" onclick=\"'+fn+'(\\''+o[0]+'\\')\">'+o[1]+'</button>'}).join('')}\nfunction ajSel(){seg('sgT',[['auto','Automático'],['claro','Claro'],['escuro','Escuro'],['tatico','Tático']],temaAtual(),'setTema');seg('sgZ',[['0.9','Pequena'],['1','Normal'],['1.15','Grande']],ls('t_zoom')||'1','setZoom')}\nfunction setTema(t){aplicaTema(t);ajSel()}function setZoom(z){aplicaZoom(z);ajSel()}\nfunction abrirAjuda(){var adm=S.adm&&S.adm.admin,sec=!!S.tok,u=(S.ini&&S.ini.urlApp)||location.href;\n var h='<div class=\"ban in\" style=\"display:block\"><b>Compartilhar o sistema</b><div class=\"nav\" style=\"margin-top:8px;justify-content:flex-start\"><button class=\"btn fill sm\" onclick=\"copiaLink()\"><span class=\"icon\">link</span>Copiar link</button>'+(navigator.share?'<button class=\"btn out sm\" onclick=\"compLink()\"><span class=\"icon\">share</span>Compartilhar</button>':'')+'</div></div>';\n function d(ic,t,b,o){return '<details'+(o?' open':'')+'><summary><span class=\"icon\">'+ic+'</span>'+t+'</summary>'+b+'</details>'}\n h+=d('login','Login e Gestão','<p>A equipe da 1ª Seção entra pelo botão <b>Login</b>, no topo, escolhendo o militar e informando a senha. Depois do login aparece a aba <b>Gestão</b> (com o número de pendentes), com Pendentes, Relatórios e, para o administrador, Auditoria e Configuração. Para sair, toque no seu nome no topo.</p>')+d('swap_horiz','Como solicitar uma troca','<p>São <b>3 etapas</b>: <b>1)</b> escolha a data (a partir de amanhã) e a escala; <b>2)</b> marque quem vai passar o serviço e escolha quem vai pegar; <b>3)</b> confira o “como fica o dia”, informe quem está pedindo e envie.</p><p>Guarde o <b>código da solicitação</b> (ex.: <b>0113NOV26</b>): em <b>Acompanhar</b> você busca por ele e vê quando a 1ª Seção decidir.</p>',true);\n h+=d('sync_alt','Permuta (troca de mão dupla)','<p>Na etapa 2, depois de escolher quem pega, marque <b>Permuta</b>: quem pega também passa um serviço dele para você, em outra data. Informe a data e a escala da devolução e toque em <b>Verificar serviço</b>. As duas solicitações são decididas juntas.</p>');\n h+=d('label','O que significam os avisos','<ul><li><b>livre</b>: pode pegar sem alertas.</li><li><b>atenção</b>: serviço no dia anterior/seguinte, folga curta ou conflito com outra solicitação.</li><li><b>fora da escala</b>: militar cadastrado que não concorre àquela escala (ou está afastado no dia).</li><li><b>Serviço já trocado</b>: o militar que passa já tem troca anotada; se esta for autorizada, ela será substituída.</li></ul><p>Os avisos não impedem a solicitação: quem decide é a 1ª Seção.</p>');\n h+=d('schedule','Prazo e fechamento do BI','<p>É preciso pedir com antecedência (hoje: <b>'+((S.ini&&S.ini.cfg.antecedencia)||0)+' dia(s)</b>). Solicitações feitas <b>após o fechamento do BI</b> para o dia seguinte exigem justificativa e só são aprovadas em caso de <b>extrema necessidade</b>. O relógio na etapa 1 mostra quanto falta para fechar. O horário depende do <b>expediente de cada dia</b> (integral, parcial ou sem expediente), definido pela 1ª Seção: o prazo de um serviço é o fechamento do BI do último dia com expediente antes dele (ex.: o BI de sexta cobre sábado, domingo e segunda). Em dia sem expediente o pedido segue normal, sem horário.</p>');\n h+=d('list_alt','Acompanhar','<p>Digite o <b>código da solicitação</b> (ex.: <b>0113NOV26</b> = 1ª solicitação do dia 13 de novembro de 2026). Abaixo da busca aparecem as 5 últimas pendentes; as demais só pelo código. O resumo por escala mostra quantas pendentes e autorizadas existem.</p>');\n h+=d('dashboard_customize','Painéis em “Ver escala”','<ul><li><b>Meu painel</b>: próximo serviço, posição na fila, folga e trocas do militar, com <b>extrato em PDF</b>.</li><li><b>Calendário</b>: o mês em mapa de calor (verde completo, amarelo apertado, vermelho déficit); toque num dia.</li><li><b>Fila</b>: ordem em que o planejador escolheria hoje.</li><li><b>Efetivo</b>: de serviço, afastado e disponível, por subunidade.</li><li><b>Afastamentos</b>: linha do tempo das férias, licenças e missões.</li><li><b>Modo TV</b>: tela cheia para a sala da guarda.</li></ul>')+d('calendar_month','Ver escala','<p>Consulta somente leitura: <b>por dia</b> (quem está de serviço em cada escala, com as trocas), <b>por militar</b> (próximo serviço, serviços do mês, trocas) e <b>por escala</b> (o mês dia a dia). O botão no topo abre a planilha completa.</p>');\n if(sec)h+=d('dashboard','Gestão: decidir solicitações','<ul><li><b>Ver como fica</b> mostra o dia antes e depois de autorizar.</li><li><b>Lote</b>: marque várias e use Autorizar/Negar selecionadas.</li><li>Autorizada, a troca é gravada como nota na escala (a prévia lê sozinha). <b>Cancelar troca</b> desfaz.</li><li>Permutas são decididas juntas.</li><li>Pendentes cujo serviço já passou <b>expiram</b> sozinhas.</li></ul>');\n if(sec)h+=d('insights','Análises (Gestão)','<ul><li><b>Riscos</b>: folga curta, muitos serviços em 7 dias, déficit de efetivo, conflitos e pedidos parados.</li><li><b>Rede de trocas</b>: quem troca com quem.</li><li><b>Desempenho</b>: funil das solicitações e tempo de decisão.</li><li><b>Mapa de calor</b>: em que dia e escala mais se troca.</li></ul>');\n if(sec)h+=d('analytics','Relatórios','<p>Filtre por período do serviço, escala e situação. Veja aprovação, tempo de decisão, quem mais passa/pega, dia da semana e a lista completa. Exporte em <b>CSV</b> ou <b>PDF</b>.</p>');\n if(adm)h+=d('admin_panel_settings','Administrador: exclusão, auditoria e configuração','<ul><li><b>Excluir</b> exige motivo e <b>apaga a solicitação definitivamente</b> da planilha (a anotação na escala também é removida). O que foi apagado fica na auditoria.</li><li><b>Auditoria</b>: acessos, solicitações, decisões e mudanças de configuração, com CSV e PDF.</li><li><b>Configuração</b>: textos, <b>avisos personalizados</b> (cartão, faixa ou mural, com validade e botão), horários do BI, antecedência, escalas com acompanhamento liberado, militares e senhas da 1ª Seção, expiração automática, novidades e QR Code/cartaz.</li></ul>');\n h+=d('palette','Aparência e tour','<div class=\"lbl\" style=\"margin-top:0\">Tema</div><div class=\"seg\" id=\"sgT\"></div><p class=\"mu\">Automático segue o tema do aparelho. <b>Tático</b>: visual de painel militar em verde, âmbar e vermelho sobre fundo preto.</p><div class=\"lbl\">Tamanho da letra</div><div class=\"seg\" id=\"sgZ\"></div><div class=\"nav\" style=\"justify-content:flex-start\"><button class=\"btn out sm\" onclick=\"fechaAjuda();tourIni()\"><span class=\"icon\">tour</span>Rever o tour</button></div>');\n h+=d('menu_book','Glossário','<dl class=\"gl\"><dt>Passa</dt><dd>Militar escalado que vai passar o serviço.</dd><dt>Pega</dt><dd>Militar que vai assumir o serviço.</dd><dt>“0”</dt><dd>Marca de serviço na escala (dia em que o militar está escalado).</dd><dt>Troca anotada (*)</dt><dd>Nota na célula do “0” com o nome de quem pegou.</dd><dt>Permuta</dt><dd>Duas trocas ligadas: ida e volta.</dd><dt>Pós-fechamento</dt><dd>Pedido feito depois do horário de fechamento do BI.</dd><dt>Expirada</dt><dd>Solicitação que ficou sem decisão até o dia do serviço.</dd></dl>');\n var nv=(S.ini&&S.ini.novidades)||'';if(nv)h+=d('new_releases','Novidades','<div class=\"nv\">'+esc(nv)+'</div>');\n $('ajC').innerHTML=h;ajSel();$('ajuda').classList.remove('hide');$('ajDot').classList.add('hide');if(S.ini)ls('t_nov',String(S.ini.novidadesVer))}\nfunction fechaAjuda(){$('ajuda').classList.add('hide')}\nfunction copiaLink(){var u=(S.ini&&S.ini.urlApp)||location.href,a=document.createElement('textarea');a.value=u;document.body.appendChild(a);a.select();try{document.execCommand('copy');aviso('ok','Link copiado.')}catch(e){aviso('er','Não foi possível copiar: '+esc(u))}document.body.removeChild(a)}\nfunction compLink(){var u=(S.ini&&S.ini.urlApp)||location.href;try{navigator.share({title:'Gestão de Escalas',url:u})}catch(e){}}\nvar TOUR=[['Escolha o serviço','Informe a data (a partir de amanhã) e a escala. O relógio mostra quanto falta para o fechamento do BI.'],['Quem passa e quem pega','Marque quem está escalado e escolha quem vai pegar. Use a busca: só militares cadastrados. Há também a opção de permuta.'],['Confira e envie','Veja como fica o dia, informe quem está pedindo e envie. Guarde o número da solicitação.'],['Acompanhe','Em “Acompanhar” busque pelo código da solicitação. Em “Ver escala”, consulte quem está de serviço. O botão Ajuda tem tudo isso e mais. A equipe da 1ª Seção entra pelo botão Login, no topo.']];\nfunction tourIni(){S.tp=0;tourMostra();$('tour').classList.remove('hide')}\nfunction tourMostra(){var t=TOUR[S.tp];$('tcn').textContent='Passo '+(S.tp+1)+' de '+TOUR.length;$('tct').textContent=t[0];$('tcp').textContent=t[1];$('tcb').textContent=S.tp===TOUR.length-1?'Concluir':'Próximo'}\nfunction tourProx(){if(S.tp>=TOUR.length-1)return tourFim();S.tp++;tourMostra()}\nfunction tourFim(){$('tour').classList.add('hide');ls('t_tour','1')}\nfunction lsOk(){try{localStorage.setItem('t_p','1');return localStorage.getItem('t_p')==='1'}catch(e){return false}}\nfunction ajIni(){if(!S.ini||!lsOk())return;if(String(S.ini.novidadesVer)!==ls('t_nov')&&ls('t_tour'))$('ajDot').classList.remove('hide');if(!ls('t_tour'))setTimeout(tourIni,600)}\n\n/* ---- resumo por escala (Acompanhar) */\nS.rx={};\nfunction carregaRes(){mostraSkSeg();$('resSub').textContent='Carregando…';run('webResumo',[S.tok||''],function(r){S.res=r;pintaRes()},function(e){$('resL').innerHTML='<div class=\"mu\">'+esc(e.message||e)+'</div>';$('resSub').textContent=''})}\nfunction pintaRes(){var r=S.res;if(!r)return;pendBadge(r.escalas.reduce(function(n,e){return n+e.pend},0));\n var tp=0,ta=0;r.escalas.forEach(function(e){tp+=e.pend;ta+=e.aut});\n $('resSub').textContent=tp+' pendente'+(tp===1?'':'s')+' · '+ta+' autorizada'+(ta===1?'':'s')+' (serviços de ontem em diante)';\n var ordenados=r.escalas.filter(function(e){return e.pend+e.aut>0}).sort(function(a,b){return (b.pend+b.aut)-(a.pend+a.aut)});\n S.ord=ordenados.map(function(e){return e.titulo});\n var h='';ordenados.forEach(function(e,ix){var t=e.titulo,ab=!!S.rx[t];\n  h+='<div class=\"rw\" onclick=\"resTog('+ix+')\"><span class=\"nm\">'+esc(t)+'</span>'+(e.pend?'<span class=\"bd p\" title=\"pendentes\">'+e.pend+'</span>':'')+(e.aut?'<span class=\"bd a\" title=\"autorizadas\">'+e.aut+'</span>':'')+'<span class=\"icon\">'+(ab?'expand_more':(e.det?'chevron_right':'lock'))+'</span></div>';\n  if(ab){h+='<div style=\"padding:0 0 8px\">';\n   if(!e.det)h+='<div class=\"ban in\" style=\"margin:0\"><span class=\"icon\">lock</span><div>Os detalhes são liberados só para a 1ª Seção. Para consultar uma solicitação, pesquise pelo código.</div></div>';\n   else h+=e.itens.map(function(x){return cardReq(x,'<div id=\"rv'+esc(x.id)+'\"></div><div class=\"acts\"><button class=\"btn out sm\" onclick=\"previaPub(\\''+esc(x.id)+'\\',this)\"><span class=\"icon\">visibility</span>Ver como fica</button></div>')}).join('');\n   h+='</div>'}});\n $('resL').innerHTML=h||'<div class=\"empty\">Nenhuma solicitação pendente ou autorizada no momento.</div>'}\nfunction resTog(i){var t=S.ord[i];S.rx[t]=!S.rx[t];pintaRes()}\nfunction previaPub(id,b){b.disabled=true;run('webPreviaPub',[id,S.tok||''],function(r){b.disabled=false;\n $('rv'+id).innerHTML='<div class=\"mu\" style=\"margin:10px 0 4px\">Como fica o dia — '+esc(r.esc)+' · '+esc(r.data)+'</div><div class=\"tw\"><table class=\"tbl\"><tr><th>Escalado</th><th>Depois da troca</th></tr>'+r.linhas.map(function(l){return '<tr style=\"'+(l.destaque?'background:var(--pc);color:var(--onpc);font-weight:500':'')+'\"><td>'+esc(l.sai)+'</td><td>'+(l.dep?'➜ '+esc(l.dep)+' *':'sem troca')+(l.destaque&&l.antes?'<div class=\"mu\" style=\"color:inherit\">antes: '+esc(l.antes)+'</div>':'')+'</td></tr>'}).join('')+'</table></div>'},function(e){b.disabled=false;aviso('er',esc(e.message||e))})}\n\n/* ---- avisos personalizáveis */\nvar AV_IC=['campaign','info','warning','error','push_pin','event','schedule','celebration','school','groups','swap_horiz','new_releases','notifications','flag'];\nfunction avRev(a){var t=(a.titulo||'')+'|'+(a.texto||'')+'|'+(a.longo||''),h=0;for(var i=0;i<t.length;i++)h=(h*31+t.charCodeAt(i))|0;return a.id+'_'+h}\nfunction avFechado(a){return ls('t_av_'+avRev(a))==='1'}\nfunction avBtn(a){return a.linkUrl?'<div class=\"avl\"><a class=\"btn fill sm\" target=\"_blank\" rel=\"noopener\" href=\"'+esc(a.linkUrl)+'\">'+esc(a.linkTxt||'Abrir')+'</a></div>':''}\nfunction avHtml(a,prev){var tom=a.tom||'info',ic='<span class=\"icon\">'+esc(a.icone||'campaign')+'</span>';\n if(a.estilo==='faixa')return '<div class=\"av2 '+tom+'\">'+ic+'<div style=\"flex:1;min-width:0\">'+(a.titulo?'<b>'+esc(a.titulo)+'</b>':'')+(a.texto?'<p>'+esc(a.texto)+'</p>':'')+avBtn(a)+'</div>'+(prev?'':'<button class=\"x\" aria-label=\"Fechar\" onclick=\"avFecha(\\''+esc(a.id)+'\\')\"><span class=\"icon\">close</span></button>')+'</div>';\n if(a.estilo==='mural'){var li=(a.texto||'').split(/\\r?\\n/).filter(function(x){return x.trim()});return '<div class=\"av3 '+tom+'\"><div class=\"t\">'+ic+esc(a.titulo||'Aviso')+'</div>'+(li.length?'<ul>'+li.map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>':'')+(a.longo?'<button class=\"more\" '+(prev?'':'onclick=\"avMais(\\''+esc(a.id)+'\\')\"')+'>Ler comunicado completo <span class=\"icon\" style=\"font-size:18px\">chevron_right</span></button>':'')+avBtn(a)+'</div>'}\n return '<div class=\"av1 '+tom+'\"><div class=\"bh\">'+ic+esc(a.titulo||'Aviso')+'</div>'+(a.texto?'<p>'+esc(a.texto)+'</p>':'')+(a.longo?'<button class=\"more\" style=\"margin-top:8px\" '+(prev?'':'onclick=\"avMais(\\''+esc(a.id)+'\\')\"')+'>Ler mais <span class=\"icon\" style=\"font-size:18px\">chevron_right</span></button>':'')+avBtn(a)+'</div>'}\nfunction pintaAvisos(){var l=(S.ini&&S.ini.avisos)||[];S.avl=l;\n var vis=l.filter(function(a){return !(a.estilo==='faixa'&&avFechado(a))});\n $('avTop').innerHTML=vis.filter(function(a){return a.onde==='todas'}).map(function(a){return avHtml(a)}).join('');\n $('avE1').innerHTML=vis.filter(function(a){return a.onde!=='todas'}).map(function(a){return avHtml(a)}).join('')}\nfunction avFecha(id){var a=(S.avl||[]).filter(function(x){return x.id===id})[0];if(a)ls('t_av_'+avRev(a),'1');pintaAvisos()}\nfunction avMais(id){var a=(S.avl||[]).filter(function(x){return x.id===id})[0];if(!a)return;$('ajC').innerHTML='<h3 class=\"ct\" style=\"margin:0 0 8px\">'+esc(a.titulo||'Aviso')+'</h3><p style=\"white-space:pre-line;font-size:15px;line-height:22px\">'+esc(a.longo)+'</p>'+avBtn(a);$('ajuda').classList.remove('hide')}\n/* configuração dos avisos (administrador) */\nfunction avNovo(){S.avs=S.avs||[];if(S.avs.length>=8)return aviso('er','Máximo de 8 avisos.');S.avs.push({id:'a'+Date.now(),ativo:true,estilo:'cartao',tom:'info',icone:'campaign',onde:'etapa1',titulo:'',texto:'',longo:'',ini:'',fim:'',linkTxt:'',linkUrl:''});avCfgTela()}\nfunction avSet(i,k,v){S.avs[i][k]=v;var p=$('avp'+i);if(p)p.innerHTML=avHtml(S.avs[i],true)}\nfunction avSetR(i,k,v){S.avs[i][k]=v;avCfgTela()}\nfunction avDel(i){if(confirm('Remover este aviso?')){S.avs.splice(i,1);avCfgTela()}}\nfunction avSel(id,i,k,op,cur,fn){return '<div class=\"f\"><select onchange=\"'+fn+'('+i+',\\''+k+'\\',this.value)\">'+op.map(function(o){return '<option value=\"'+o[0]+'\"'+(o[0]===cur?' selected':'')+'>'+o[1]+'</option>'}).join('')+'</select><label>'+id+'</label></div>'}\nfunction avCfgTela(){var e=$('c-av');if(!e)return;var l=S.avs||[];\n e.innerHTML=(l.len