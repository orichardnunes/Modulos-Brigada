utton><button class=\"usr hide\" id=\"btnUsr\" onclick=\"abrirUsr()\"><i id=\"usrI\"></i><span id=\"usrN\"></span></button><div class=\"prog\"><i id=\"pg\"></i></div></header>\n<main class=\"wrap\">\n<div id=\"avTop\"></div>\n<div id=\"msg\"></div>\n\n<!-- SOLICITAR -->\n<section id=\"v-sol\">\n <div class=\"stp\"><span class=\"sc\" id=\"stc\">Etapa 1 de 3</span><span class=\"sn\" id=\"stn\">Escolha do serviço</span></div>\n\n <div class=\"card\" id=\"s1\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">event</span></span><div><h2 class=\"ct\">Qual serviço?</h2><div class=\"cs\">Escolha a data e a escala</div></div></div>\n  <div id=\"avE1\"></div>\n  <div class=\"bi\" id=\"aviBI\"><div class=\"bh\"><span class=\"icon\">schedule</span><span id=\"biT\"></span></div><div class=\"tm\"><div id=\"biI\"><small>Expediente integral</small><b></b></div><div id=\"biP\"><small>Expediente parcial</small><b></b></div></div><div class=\"clk hide\" id=\"biClk\"><span class=\"icon\">timer</span><span id=\"biClkT\"></span></div><details class=\"bid\"><summary>Ver regra do prazo</summary><div class=\"mu\" id=\"biCob\" style=\"margin-top:6px;color:inherit;opacity:.9\"></div><p id=\"biN\"></p></details></div>\n  <div class=\"f\"><input type=\"date\" id=\"data\"><label for=\"data\">Data do serviço</label></div>\n  <div class=\"mu\" id=\"dmin\" style=\"margin:-10px 0 6px\"></div>\n  <div class=\"mu\" id=\"prazoInfo\" style=\"margin:0 0 14px;color:var(--p);font-weight:500\"></div>\n  <div class=\"f\"><select id=\"esc\" onchange=\"aoEscala()\"></select><label for=\"esc\">Escala</label></div>\n  <div class=\"nav\"><span></span><button class=\"btn fill\" id=\"b1\" onclick=\"vaiDia()\">Avançar<span class=\"icon\">arrow_forward</span></button></div>\n </div>\n\n <div class=\"card hide\" id=\"s2\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">groups</span></span><div><h2 class=\"ct\">Quem passa e quem pega</h2><div class=\"cs\" id=\"s2sub\"></div></div></div>\n  <d