gba(0,0,0,.5);display:grid;place-items:center;padding:12px\"><div class=\"card\" style=\"max-width:620px;width:100%;margin:0;max-height:92vh;display:flex;flex-direction:column;padding:0\"><div style=\"display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--olv)\"><h2 class=\"ct\" style=\"font-size:18px\">Ajuda</h2><button class=\"btn out sm\" onclick=\"fechaAjuda()\" aria-label=\"Fechar\"><span class=\"icon\">close</span></button></div><div class=\"aj\" id=\"ajC\" style=\"padding:12px 16px;overflow:auto\"></div></div></div>\n<div id=\"tour\" class=\"hide\" style=\"position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.55);display:grid;place-items:end center;padding:16px\"><div class=\"card\" style=\"max-width:440px;width:100%;margin:0 0 70px\"><div class=\"sc\" id=\"tcn\"></div><h2 class=\"ct\" id=\"tct\" style=\"margin:4px 0 6px\"></h2><p class=\"mu\" id=\"tcp\" style=\"font-size:14px;line-height:20px;margin:0 0 12px\"></p><div class=\"nav\"><button class=\"btn out sm\" onclick=\"tourFim()\">Pular</button><button class=\"btn fill sm\" id=\"tcb\" onclick=\"tourProx()\">Próximo</button></div></div></div>\n<div id=\"lgm\" class=\"hide\" style=\"position:fixed;inset:0;z-index:130;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center\"><div class=\"card\" style=\"width:100%;max-width:520px;margin:0;border-radius:20px 20px 0 0\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">lock</span></span><div><h2 class=\"ct\">Login</h2><div class=\"cs\">Acesso da equipe da 1ª Seção</div></div></div>\n <div class=\"f\"><select id=\"an\"></select><label for=\"an\">Militar</label></div>\n <div class=\"f\"><input type=\"password\" id=\"pin\" autocomplete=\"current-password\" onkeydown=\"if(event.key===\\'Enter\\')entrar()\"><label for=\"pin\">Senha</label></div>\n <div class=\"nav\"><button class=\"btn out\" onclick=\"fechaLogin()\">Cancelar</button><button class=\"btn fill\" onclick=\"entrar()\"><span class=\"icon\">login</span>Entrar</button></div></div></div>\n<div id=\"usm\" class=\"hide\" style=\"position:fixed;inset:0;z-index:130;background:rgba(0,0,0,.5);display:grid;place-items:center;padding:16px\"><div class=\"card\" style=\"max-width:360px;width:100%;margin:0\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">badge</span></span><div><h2 class=\"ct\" id=\"usmN\"></h2><div class=\"cs\" id=\"usmP\"></div></div></div><p class=\"mu\" style=\"font-size:13px;line-height:18px;margin:0 0 12px\">Os acessos e as decisões ficam registrados na auditoria.</p><div class=\"nav\"><button class=\"btn out\" onclick=\"$(\\'usm\\').classList.add(\\'hide\\')\">Fechar</button><button class=\"btn err\" onclick=\"$(\\'usm\\').classList.add(\\'hide\\');sair()\"><span class=\"icon\">logout</span>Sair</button></div></div></div>\n<div id=\"tvm\" class=\"hide tvwrap\"><div class=\"tvtop\"><b id=\"tvT\"></b><span class=\"ck\" id=\"tvC\"></span><button onclick=\"tvFecha()\" aria-label=\"Sair do modo painel\">✕</button></div><div class=\"tvg\" id=\"tvG\"></div><div class=\"tvft\"><span>Atualiza sozinho a cada 60 s</span><span id=\"tvU\"></span></div></div>\n<div id=\"mdl\" class=\"hide\" style=\"position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.5);display:grid;place-items:center;padding:16px\"><div class=\"card\" style=\"max-width:440px;width:100%;margin:0\"><h2 class=\"ct\" id=\"mdT\"></h2><p class=\"mu\" id=\"mdP\" style=\"margin:6px 0 12px;font-size:13px;line-height:18px\"></p><div class=\"f\"><textarea id=\"mdI\" maxlength=\"200\" placeholder=\" \"></textarea><label id=\"mdL\" for=\"mdI\"></label></div><div class=\"nav\"><button class=\"btn out\" onclick=\"mdFecha()\">Cancelar</button><button class=\"btn err\" id=\"mdOk\">Confirmar</button></div></div></div>\n<div id=\"poster\"><div class=\"pb\"><div>Gestão de Escalas</div><small id=\"pSub\"></small></div><h1>Troque seu serviço pelo celular</h1><div class=\"qq\" id=\"qrBig\"></div><p>Aponte a câmera para o QR Code, escolha a data e a escala, e envie a solicitação à 1ª Seção.</p><p class=\"u\" id=\"pUrl\"></p></div>\n<nav class=\"bn\"><button id=\"n-sol\" class=\"on\" onclick=\"aba('sol')\"><span class=\"icon\">swap_horiz</span>Solicitar</button><button id=\"n-seg\" onclick=\"aba('seg')\"><span class=\"icon\">list_alt</span>Acompanhar<i class=\"bdg hide\" id=\"bdg\" title=\"Solicitações pendentes\"></i></button><button id=\"n-esc\" onclick=\"aba('esc')\"><span class=\"icon\">calendar_month</span>Ver escala</button><button id=\"n-aut\" class=\"hide\" onclick=\"aba('aut')\"><span class=\"icon\">dashboard</span>Gestão<i class=\"bdg hide\" id=\"bdgG\"></i></button></nav>\n\n<script>\nvar $=function(i){return document.getElementById(i)};\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nvar BUSY=0,BT=null;\nfunction busy(n){BUSY=Math.max(0,BUSY+n);clearTimeout(BT);if(BUSY>0)BT=setTimeout(function(){$('gpb').classList.add('on')},150);else $('gpb').classList.remove('on')}\nfunction run(fn,args,ok,er){busy(1);var r=google.script.run.withSuccessHandler(function(x){busy(-1);ok(x)}).withFailureHandler(function(e){busy(-1);var m=(e&&e.message)||String(e);if(/Sessão expirada/.test(m)){sair(true)}er?er(e):aviso('er',esc(m))});r[fn].apply(r,args)}\nfunction aviso(t,m){var i={ok:'check_circle',er:'error',wa:'warning',in:'info'}[t];$('msg').innerHTML=m?'<div class=\"ban '+t+'\" role=\"alert\"><span class=\"icon\">'+i+'</span><div>'+m+'</div></div>':'';if(m)window.scrollTo(0,0)}\nfunction ls(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}\nvar S={ini:null,sel:null,dia:null,sai:null,entra:null,tok:'',adm:null,sub:'pend',step:1,rel:null,cfg:null};\nvar PG=[0,33,66,100];\nvar SEMG=/^(\\d+\\s*º?\\s*SGT|SD\\s*EP|SD\\s*EV|CB\\s*EP|CB|SGT|ST|TEN|CAP)\\s+/;\nfunction norm(s){return String(s).normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase().replace(/\\s+/g,' ').trim()}\nfunction brd(iso){var p=String(iso).split('-');return p[2]+'/'+p[1]+'/'+p[0]}\n\nfunction aba(t){if(t==='aut'&&!S.tok)t='sol';aviso('','');['sol','seg','esc','aut'].forEach(function(x){$('v-'+x).classList.toggle('hide',x!==t);$('n-'+x).classList.toggle('on',x===t)});\n if(t==='sol')$('pg').style.width=PG[Math.min(S.step,3)]+'%';else $('pg').style.width='0';\n if(t==='seg')prepSeg();if(t==='esc')escIni(); if(t==='aut'&&S.tok)subTab(S.sub)}\nfunction passo(n){S.step=n;aviso('','');['s1','s2','s3','s4'].forEach(function(x,i){$(x).classList.toggle('hide',i+1!==n)});\n $('stc').textContent=n<4?'Etapa '+n+' de 3':'Concluído';$('stn').textContent=['','Escolha do serviço','Guarnição de Serviço','Conferência','Solicitação enviada'][n];$('pg').style.width=(n===4?100:PG[n])+'%';window.scrollTo(0,0)}\n\n/* ---- combo de militares cadastrados */\nfunction combo(inp,box){var q=norm($(inp).value),b=$(box);if(!S.ini){return}\n var l=S.ini.mil.filter(function(m){return !q||norm(m).indexOf(q)>=0}).slice(0,12);\n if(!l.length||(l.length===1&&norm(l[0])===q)){b.classList.add('hide');return}\n b.innerHTML=l.map(function(m,i){return '<div data-i=\"'+i+'\">'+esc(m)+'</div>'}).join('');b.classList.remove('hide');\n Array.prototype.forEach.call(b.children,function(d,i){d.onmousedown=function(e){e.preventDefault();$(inp).value=l[i];b.classList.add('hide')}})}\ndocument.addEventListener('click',function(e){Array.prototype.forEach.call(document.querySelectorAll('.sug'),function(b){if(!b.parentNode.contains(e.target))b.classList.add('hide')})});\nfunction milValido(txt){var n=norm(txt);if(!S.ini.cadOk)return txt.trim();var m=S.ini.mil.filter(function(x){return norm(x)===n})[0];return m||null}\nfunction achaMil(txt){return S.ini.mil.filter(function(m){return mesmoMil(m,txt)})[0]||null}\n\n/* ---- carregamento: esqueletos, aviso sobre a tela, botões e abertura */\nfunction sk(w,h,m){return '<div class=\"sk\" style=\"width:'+w+'%;height:'+(h||12)+'px;margi