var HTML_TROCAS_WEB_ = "<!DOCTYPE html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>Gestão de Serviços de Escalas</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block\" rel=\"stylesheet\">\n<style>\n:root{color-scheme:light dark;--p:#3A6A35;--onp:#fff;--pc:#BBF0AE;--onpc:#002201;--sc:#D7E8CD;--onsc:#121F0E;--er:#BA1A1A;--erc:#FFDAD6;--oner:#410002;--s:#F8FAF0;--sl:#F2F5EB;--sm:#ECEFE5;--sh:#E6E9DF;--on:#191D17;--onv:#43483F;--ol:#73796E;--olv:#C3C8BB;--wa:#FFE9B5;--onwa:#3B2A00;--font:'Roboto',system-ui,-apple-system,'Segoe UI',sans-serif}\n@media(prefers-color-scheme:dark){:root{--p:#A0D494;--onp:#063909;--pc:#215023;--onpc:#BBF0AE;--sc:#3C4B37;--onsc:#D7E8CD;--er:#FFB4AB;--erc:#93000A;--oner:#FFDAD6;--s:#11140F;--sl:#191D17;--sm:#1D211B;--sh:#272B25;--on:#E1E4DA;--onv:#C3C8BB;--ol:#8D9387;--olv:#43483F;--wa:#4A3A00;--onwa:#FFE9B5}}\n*{box-sizing:border-box}html,body{margin:0;width:100%;max-width:100vw;overflow-x:hidden}\nbody{background:var(--s);color:var(--on);font:400 16px/24px var(--font);letter-spacing:.3px;-webkit-font-smoothing:antialiased;padding-bottom:88px}\n.icon{font-family:'Material Symbols Outlined';font-weight:400;font-style:normal;font-size:24px;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;direction:ltr;font-feature-settings:'liga';user-select:none;flex:none}\n.bar{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:16px;min-height:64px;padding:8px 16px;background:var(--sm);border-bottom:1px solid var(--olv)}\n.bar .ai{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--pc);color:var(--onpc)}\n.bar h1{margin:0;font:400 19px/24px var(--font);letter-spacing:0}.bar .sub{font:500 12px/16px var(--font);color:var(--onv)}\n.bar .t{flex:1;min-width:0}\n.prog{position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--sh)}.prog i{display:block;height:100%;width:0;background:var(--p);transition:width .25s}\n.wrap{max-width:760px;margin:0 auto;padding:16px}\n.card{background:var(--sl);border:1px solid var(--olv);border-radius:16px;padding:16px;margin:0 0 16px}\n.ch{display:flex;align-items:center;gap:12px;margin-bottom:12px}\n.ib{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--pc);color:var(--onpc)}\n.ct{font:500 16px/24px var(--font);margin:0}.cs{font:400 12px/16px var(--font);color:var(--onv)}\n.stp{display:flex;align-items:center;gap:8px;margin:0 0 12px}.sc{font:500 12px/16px var(--font);color:var(--p);text-transform:uppercase;letter-spacing:.6px}.sn{font:400 14px/20px var(--font);color:var(--onv)}\n.f{position:relative;margin-bottom:16px}\n.f select,.f input,.f textarea{width:100%;font:400 16px/24px var(--font);color:var(--on);background:transparent;border:1px solid var(--ol);border-radius:4px;padding:16px 14px 8px;outline:none;appearance:none;-webkit-appearance:none;min-height:56px}\n.f textarea{min-height:88px;resize:vertical}\n.f select{background-image:linear-gradient(45deg,transparent 50%,var(--onv) 50%),linear-gradient(135deg,var(--onv) 50%,transparent 50%);background-position:calc(100% - 20px) 26px,calc(100% - 14px) 26px;background-size:6px 6px;background-repeat:no-repeat;padding-right:36px}\n.f select option{background:var(--sl);color:var(--on)}\n.f label{position:absolute;left:12px;top:4px;padding:0 4px;background:var(--sl);font:400 12px/16px var(--font);color:var(--onv);pointer-events:none}\n.f select:focus,.f input:focus,.f textarea:focus{border-color:var(--p);box-shadow:inset 0 0 0 1px var(--p)}\n.f:focus-within label{color:var(--p)}\n.f input[type=checkbox]{width:20px;height:20px;min-height:0;padding:0;accent-color:var(--p)}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border:0;border-radius:22px;font:500 14px/20px var(--font);letter-spacing:.1px;cursor:pointer;background:var(--sc);color:var(--onsc)}\n.btn.fill{background:var(--p);color:var(--onp)}.btn.out{background:transparent;color:var(--p);border:1px solid var(--ol)}.btn.err{background:var(--erc);color:var(--oner)}.btn.sm{height:34px;padding:0 14px}\n.btn[disabled]{opacity:.45;cursor:not-allowed}.btn .icon{font-size:20px}\n.nav{display:flex;gap:8px;justify-content:space-between;margin-top:8px;flex-wrap:wrap}\n.opts{display:flex;flex-direction:column;gap:8px}\n.opt{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--olv);border-radius:12px;background:var(--s);cursor:pointer}\n.opt input{accent-color:var(--p);width:20px;height:20px;margin:0}\n.opt.sel{border-color:var(--p);background:var(--pc);color:var(--onpc)}\n.opt .n{flex:1;min-width:0}.opt .n b{font-weight:500}.opt .n small{display:block;color:var(--onv);font-size:12px;line-height:16px}.opt.sel .n small{color:var(--onpc)}\n.tg{display:inline-flex;align-items:center;gap:4px;padding:0 8px;border-radius:8px;font:500 11px/20px var(--font)}\n.tg.ok{background:var(--pc);color:var(--onpc)}.tg.al{background:var(--wa);color:var(--onwa)}\n.ban{display:flex;gap:12px;align-items:flex-start;padding:12px 16px;border-radius:12px;margin:0 0 16px;font:400 14px/20px var(--font)}\n.ban.ok{background:var(--pc);color:var(--onpc)}.ban.er{background:var(--erc);color:var(--oner)}.ban.wa{background:var(--wa);color:var(--onwa)}.ban.in{background:var(--sc);color:var(--onsc)}\n.mu{color:var(--onv);font-size:12px;line-height:16px}\n.sum{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:14px;line-height:20px}.sum dt{color:var(--onv)}.sum dd{margin:0;font-weight:500}\n.pill{display:inline-block;padding:0 10px;border-radius:12px;font:500 12px/22px var(--font)}\n.pill.Pendente{background:var(--wa);color:var(--onwa)}.pill.Autorizada{background:var(--pc);color:var(--onpc)}.pill.Negada,.pill.Inválida{background:var(--erc);color:var(--oner)}.pill.Cancelada{background:var(--sh);color:var(--onv)}\n.req{border:1px solid var(--olv);border-radius:12px;padding:12px 14px;margin:0 0 12px;background:var(--s)}\n.req .h{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px;flex-wrap:wrap}\n.req .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.req .acts .btn{height:40px}\n.bn{position:fixed;left:0;right:0;bottom:0;z-index:60;display:flex;background:var(--sm);border-top:1px solid var(--olv);padding:8px 8px calc(8px + env(safe-area-inset-bottom))}\n.bn button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;border:0;background:transparent;color:var(--onv);font:500 12px/16px var(--font);cursor:pointer;padding:4px 0}\n.bn button .icon{width:56px;height:32px;display:grid;place-items:center;border-radius:16px}\n.bn button.on{color:var(--on)}.bn button.on .icon{background:var(--pc);color:var(--onpc)}\n.hide{display:none!important}\n.sp{display:inline-block;width:18px;height:18px;border:3px solid var(--olv);border-top-color:var(--p);border-radius:50%;animation:g .8s linear infinite;vertical-align:middle}@keyframes g{to{transform:rotate(360deg)}}\n.empty{text-align:center;color:var(--onv);padding:24px 8px}\n.cb{position:relative}.sug{position:absolute;left:0;right:0;top:100%;z-index:20;background:var(--sl);border:1px solid var(--ol);border-radius:8px;max-height:240px;overflow:auto;margin-top:-12px;box-shadow:0 4px 12px rgba(0,0,0,.2)}\n.sug div{padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--olv)}.sug div:last-child{border:0}.sug div:hover{background:var(--pc);color:var(--onpc)}\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 14px}.chp{border:1px solid var(--ol);border-radius:16px;padding:4px 14px;font:500 13px/20px var(--font);cursor:pointer;background:transparent;color:var(--onv)}.chp.on{background:var(--pc);color:var(--onpc);border-color:var(--p)}\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:0 0 14px}.kpi{border:1px solid var(--olv);border-radius:12px;padding:10px 12px;background:var(--s)}.kpi b{display:block;font:500 24px/30px var(--font)}.kpi span{font-size:12px;color:var(--onv)}\n.br{display:flex;align-items:center;gap:8px;margin:4px 0;font-size:13px}.br .l{flex:0 0 40%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.br .b{flex:1;background:var(--sh);border-radius:4px;height:14px;overflow:hidden;display:flex}.br .b i{display:block;height:100%}.br .v{flex:0 0 auto;font-weight:500;min-width:28px;text-align:right}\n.ga{background:var(--p)}.gn{background:var(--er)}.go{background:var(--ol)}\n.sr{display:flex;align-items:flex-end;gap:3px;height:70px;margin:6px 0}.sr i{flex:1;background:var(--p);border-radius:3px 3px 0 0;min-height:2px}\n.tbl{width:100%;border-collapse:collapse;font-size:13px}.tbl th{text-align:left;color:var(--onv);font-weight:500;padding:6px 6px;border-bottom:2px solid var(--olv);white-space:nowrap}.tbl td{padding:6px;border-bottom:1px solid var(--olv);vertical-align:top}\n.tw{overflow-x:auto}\n.r2{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:520px){.r2{grid-template-columns:1fr}}\n.mem{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;border:1px solid var(--olv);border-radius:10px;padding:8px 10px;margin:0 0 8px;background:var(--s)}.mem .f{margin:0;grid-column:1/-1}\n.lbl{font:500 13px/18px var(--font);color:var(--onv);margin:14px 0 6px}\n</style></head><body>\n<header class=\"bar\"><span class=\"ai\"><span class=\"icon\">swap_horiz</span></span><div class=\"t\"><h1 id=\"ttl\">Gestão de Serviços de Escalas</h1><div class=\"sub\" id=\"sub\">S/1 - Seção de Pessoal</div></div><div class=\"prog\"><i id=\"pg\"></i></div></header>\n<main class=\"wrap\">\n<div id=\"msg\"></div>\n\n<!-- SOLICITAR -->\n<section id=\"v-sol\">\n <div class=\"stp\"><span class=\"sc\" id=\"stc\">Etapa 1 de 3</span><span class=\"sn\" id=\"stn\">Escolha do serviço</span></div>\n\n <div class=\"card\" id=\"s1\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">event</span></span><div><h2 class=\"ct\">Qual serviço?</h2><div class=\"cs\">Escolha a data e a escala</div></div></div>\n  <div class=\"ban wa\" id=\"aviBI\"><span class=\"icon\">schedule</span><div id=\"aviBIt\"></div></div>\n  <div class=\"f\"><input type=\"date\" id=\"data\"><label for=\"data\">Data do serviço</label></div>\n  <div class=\"mu\" id=\"dmin\" style=\"margin:-10px 0 14px\"></div>\n  <div class=\"f\"><select id=\"esc\"></select><label for=\"esc\">Escala</label></div>\n  <div class=\"nav\"><span></span><button class=\"btn fill\" id=\"b1\" onclick=\"vaiDia()\">Avançar<span class=\"icon\">arrow_forward</span></button></div>\n </div>\n\n <div class=\"card hide\" id=\"s2\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">groups</span></span><div><h2 class=\"ct\">Quem passa e quem pega</h2><div class=\"cs\" id=\"s2sub\"></div></div></div>\n  <div class=\"mu\" style=\"margin-bottom:6px\">Quem está escalado (militar que vai passar o serviço)</div><div class=\"opts\" id=\"lsai\"></div>\n  <div id=\"ltr\"></div>\n  <div class=\"mu\" style=\"margin:16px 0 6px\">Quem vai pegar o serviço</div>\n  <div class=\"f\" style=\"margin-bottom:8px\"><input type=\"search\" id=\"busca\" placeholder=\" \" oninput=\"pintaEntra()\" autocomplete=\"off\"><label for=\"busca\">Buscar militar (somente cadastrados)</label></div>\n  <div class=\"opts\" id=\"lentra\"></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"passo(1)\"><span class=\"icon\">arrow_back</span>Voltar</button><button class=\"btn fill\" id=\"b2\" onclick=\"vaiRev()\">Avançar<span class=\"icon\">arrow_forward</span></button></div>\n </div>\n\n <div class=\"card hide\" id=\"s3\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">fact_check</span></span><div><h2 class=\"ct\">Conferir e enviar</h2><div class=\"cs\">A 1ª Seção vai autorizar ou negar</div></div></div>\n  <dl class=\"sum\" id=\"rev\"></dl>\n  <div id=\"rav\"></div>\n  <div class=\"mu\" style=\"margin:16px 0 6px\">Como fica o dia depois da troca</div><div id=\"prev\"></div>\n  <div class=\"f cb\" style=\"margin-top:16px\"><input type=\"text\" id=\"sol\" autocomplete=\"off\" oninput=\"combo('sol','sugsol')\" onfocus=\"combo('sol','sugsol')\"><label for=\"sol\">Solicitação feita por (militar cadastrado)</label><div class=\"sug hide\" id=\"sugsol\"></div></div>\n  <div class=\"f\"><textarea id=\"mot\" maxlength=\"300\"></textarea><label for=\"mot\">Motivo (opcional)</label></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"passo(2)\"><span class=\"icon\">arrow_back</span>Voltar</button><button class=\"btn fill\" id=\"b3\" onclick=\"envia()\"><span class=\"icon\">send</span>Enviar solicitação</button></div>\n </div>\n\n <div class=\"card hide\" id=\"s4\">\n  <div class=\"ban ok\"><span class=\"icon\">check_circle</span><div><b>Solicitação enviada</b><div id=\"okid\"></div></div></div>\n  <p class=\"mu\">Guarde o número da solicitação para consulta. Em <b>Acompanhar</b> você vê quando a 1ª Seção aprovar.</p>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"verMinha()\"><span class=\"icon\">list_alt</span>Acompanhar</button><button class=\"btn fill\" onclick=\"novo()\"><span class=\"icon\">add</span>Nova solicitação</button></div>\n </div>\n</section>\n\n<!-- ACOMPANHAR -->\n<section id=\"v-seg\" class=\"hide\">\n <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">list_alt</span></span><div><h2 class=\"ct\">Solicitações</h2><div class=\"cs\">Trocas solicitadas à 1ª Seção</div></div></div>\n <div class=\"r2\"><div class=\"f\"><input type=\"text\" id=\"qn\" inputmode=\"numeric\" placeholder=\" \"><label for=\"qn\">Número da solicitação (ex.: 001)</label></div><div class=\"f\"><input type=\"date\" id=\"qd\"><label for=\"qd\">Data da solicitação</label></div></div>\n <div class=\"nav\" style=\"margin-bottom:8px\"><span></span><button class=\"btn fill\" onclick=\"busca1()\"><span class=\"icon\">search</span>Buscar</button></div>\n <div id=\"qvis\" class=\"hide\"><div class=\"lbl\">Acompanhar as trocas da minha escala</div>\n  <div class=\"f cb\"><input type=\"text\" id=\"qm\" autocomplete=\"off\" oninput=\"combo('qm','sugqm')\" onfocus=\"combo('qm','sugqm')\"><label for=\"qm\">Sou o militar (cadastrado)</label><div class=\"sug hide\" id=\"sugqm\"></div></div>\n  <div class=\"mu\" style=\"margin:-6px 0 8px\">A 1ª Seção liberou o acompanhamento das trocas de algumas escalas para quem faz parte delas.</div></div>\n <div id=\"lseg\"></div></div>\n</section>\n\n<!-- 1ª SEÇÃO -->\n<section id=\"v-aut\" class=\"hide\">\n <div class=\"card\" id=\"login\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">lock</span></span><div><h2 class=\"ct\">1ª Seção</h2><div class=\"cs\">Selecione seu nome e informe a senha</div></div></div>\n  <div class=\"f\"><select id=\"an\"></select><label for=\"an\">Militar da 1ª Seção</label></div>\n  <div class=\"f\"><input type=\"password\" id=\"pin\" autocomplete=\"current-password\"><label for=\"pin\">Senha</label></div>\n  <div class=\"nav\"><span></span><button class=\"btn fill\" onclick=\"entrar()\"><span class=\"icon\">login</span>Entrar</button></div>\n </div>\n <div id=\"painel\" class=\"hide\">\n  <div class=\"ban in\"><span class=\"icon\">badge</span><div id=\"quem\"></div></div>\n  <div class=\"chips\" id=\"sub-nav\"></div>\n  <div id=\"p-pend\">\n   <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">pending_actions</span></span><div><h2 class=\"ct\">Solicitações pendentes</h2><div class=\"cs\" id=\"psub\"></div></div></div><div id=\"lpend\"></div></div>\n   <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">history</span></span><div><h2 class=\"ct\">Autorizadas recentemente</h2><div class=\"cs\">Pode cancelar uma troca já autorizada</div></div></div><div id=\"laut\"></div></div>\n  </div>\n  <div id=\"p-rel\" class=\"hide\"></div>\n  <div id=\"p-aud\" class=\"hide\"></div>\n  <div id=\"p-cfg\" class=\"hide\"></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"sair()\"><span class=\"icon\">logout</span>Sair</button><button class=\"btn out\" onclick=\"subTab(S.sub)\"><span class=\"icon\">refresh</span>Atualizar</button></div>\n </div>\n</section>\n</main>\n\n<nav class=\"bn\"><button id=\"n-sol\" class=\"on\" onclick=\"aba('sol')\"><span class=\"icon\">swap_horiz</span>Solicitar</button><button id=\"n-seg\" onclick=\"aba('seg')\"><span class=\"icon\">list_alt</span>Acompanhar</button><button id=\"n-aut\" onclick=\"aba('aut')\"><span class=\"icon\">verified_user</span>1ª Seção</button></nav>\n\n<script>\nvar $=function(i){return document.getElementById(i)};\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction run(fn,args,ok,er){var r=google.script.run.withSuccessHandler(ok).withFailureHandler(function(e){var m=(e&&e.message)||String(e);if(/Sessão expirada/.test(m)){sair(true)}er?er(e):aviso('er',esc(m))});r[fn].apply(r,args)}\nfunction aviso(t,m){var i={ok:'check_circle',er:'error',wa:'warning',in:'info'}[t];$('msg').innerHTML=m?'<div class=\"ban '+t+'\" role=\"alert\"><span class=\"icon\">'+i+'</span><div>'+m+'</div></div>':'';if(m)window.scrollTo(0,0)}\nfunction ls(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}\nvar S={ini:null,sel:null,dia:null,sai:null,entra:null,tok:'',adm:null,sub:'pend',step:1,rel:null,cfg:null};\nvar PG=[0,33,66,100];\nvar SEMG=/^(\\d+\\s*º?\\s*SGT|SD\\s*EP|SD\\s*EV|CB\\s*EP|CB|SGT|ST|TEN|CAP)\\s+/;\nfunction norm(s){return String(s).normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase().replace(/\\s+/g,' ').trim()}\nfunction brd(iso){var p=String(iso).split('-');return p[2]+'/'+p[1]+'/'+p[0]}\n\nfunction aba(t){aviso('','');['sol','seg','aut'].forEach(function(x){$('v-'+x).classList.toggle('hide',x!==t);$('n-'+x).classList.toggle('on',x===t)});\n if(t==='sol')$('pg').style.width=PG[Math.min(S.step,3)]+'%';else $('pg').style.width='0';\n if(t==='seg')prepSeg(); if(t==='aut'&&S.tok)subTab(S.sub)}\nfunction passo(n){S.step=n;aviso('','');['s1','s2','s3','s4'].forEach(function(x,i){$(x).classList.toggle('hide',i+1!==n)});\n $('stc').textContent=n<4?'Etapa '+n+' de 3':'Concluído';$('stn').textContent=['','Escolha do serviço','Guarnição de Serviço','Conferência','Solicitação enviada'][n];$('pg').style.width=(n===4?100:PG[n])+'%';window.scrollTo(0,0)}\n\n/* ---- combo de militares cadastrados */\nfunction combo(inp,box){var q=norm($(inp).value),b=$(box);if(!S.ini){return}\n var l=S.ini.mil.filter(function(m){return !q||norm(m).indexOf(q)>=0}).slice(0,12);\n if(!l.length||(l.length===1&&norm(l[0])===q)){b.classList.add('hide');return}\n b.innerHTML=l.map(function(m,i){return '<div data-i=\"'+i+'\">'+esc(m)+'</div>'}).join('');b.classList.remove('hide');\n Array.prototype.forEach.call(b.children,function(d,i){d.onmousedown=function(e){e.preventDefault();$(inp).value=l[i];b.classList.add('hide')}})}\ndocument.addEventListener('click',function(e){Array.prototype.forEach.call(document.querySelectorAll('.sug'),function(b){if(!b.parentNode.contains(e.target))b.classList.add('hide')})});\nfunction milValido(txt){var n=norm(txt);if(!S.ini.cadOk)return txt.trim();var m=S.ini.mil.filter(function(x){return norm(x)===n})[0];return m||null}\nfunction achaMil(txt){var n=norm(txt),k=n.replace(SEMG,'');return S.ini.mil.filter(function(m){var a=norm(m);return a===n||a.slice(-(k.length+1))===' '+k})[0]||null}\n\n/* ---- início */\nfunction inicia(){ $('an').innerHTML='<option value=\"\">Carregando…</option>';\n run('webInicio',[],function(r){S=Object.assign(S,{ini:r});var c=r.cfg;$('ttl').textContent=c.titulo;$('sub').textContent=c.subtitulo;document.t