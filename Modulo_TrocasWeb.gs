pts\" id=\"lsai\"></div>\n    <div class=\"mu\" style=\"margin:16px 0 6px\">Quem vai pegar o serviço</div>\n  <div class=\"f\" style=\"margin-bottom:8px\"><input type=\"search\" id=\"busca\" placeholder=\" \" oninput=\"pintaEntra()\" autocomplete=\"off\"><label for=\"busca\">Buscar militar (somente cadastrados)</label></div>\n  <div class=\"opts\" id=\"lentra\"></div>\n  <div id=\"permBox\" class=\"hide\"><label class=\"opt\" style=\"margin-top:14px\"><input type=\"checkbox\" id=\"permChk\" onchange=\"permToggle()\"><span class=\"n\"><b>Permuta (troca de mão dupla)</b><small>Quem pega também passa um serviço dele para você, em outra data.</small></span></label>\n   <div id=\"permForm\" class=\"hide\" style=\"margin-top:10px;border:1px solid var(--olv);border-radius:12px;padding:12px;background:var(--s)\"><div class=\"mu\" style=\"margin-bottom:10px\" id=\"permT\"></div>\n    <div class=\"f\"><input type=\"date\" id=\"pd\" onchange=\"fillEscSel('pd','pe')\"><label for=\"pd\">Data do serviço de devolução</label></div>\n    <div class=\"f\"><select id=\"pe\" onchange=\"S.perm=null;$('permRes').innerHTML=''\"></select><label for=\"pe\">Escala</label></div>\n    <button class=\"btn out sm\" id=\"pvb\" onclick=\"permVerifica()\"><span class=\"icon\">fact_check</span>Verificar serviço</button><div id=\"permRes\" style=\"margin-top:10px\"></div></div></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"passo(1)\"><span class=\"icon\">arrow_back</span>Voltar</button><button class=\"btn fill\" id=\"b2\" onclick=\"vaiRev()\">Avançar<span class=\"icon\">arrow_forward</span></button></div>\n </div>\n\n <div class=\"card hide\" id=\"s3\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">fact_check</span></span><div><h2 class=\"ct\">Conferir e enviar</h2><div class=\"cs\">A 1ª Seção vai autorizar ou negar</div></div></div>\n  <dl class=\"sum\" id=\"rev\"></dl>\n  <div id=\"rav\"></div>\n  <div class=\"mu\" style=\"margin:16px 0 6px\">Como fica o dia depois da troca</div><div id=\"prev\"></div>\n  <div class=\"f cb\" style=\"margin-top:16px\"><input type=\"text\" id=\"sol\" autocomplete=\"off\" oninput=\"combo('sol','sugsol')\" onfocus=\"combo('sol','sugsol')\"><label for=\"sol\">Solicitação feita por (militar cadastrado)</label><div class=\"sug hide\" id=\"sugsol\"></div></div>\n  <div class=\"f\"><textarea id=\"mot\" maxlength=\"300\"></textarea><label for=\"mot\" id=\"motL\">Motivo (opcional)</label></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"passo(2)\"><span class=\"icon\">arrow_back</span>Voltar</button><button class=\"btn fill\" id=\"b3\" onclick=\"envia()\"><span class=\"icon\">send</span>Enviar solicitação</button></div>\n </div>\n\n <div class=\"card hide\" id=\"s4\">\n  <div class=\"ban ok\"><span class=\"icon\">check_circle</span><div><b>Solicitação enviada</b><div id=\"okid\"></div></div></div>\n  <p class=\"mu\">Guarde o número da solicitação para consulta. Em <b>Acompanhar</b> você vê quando a 1ª Seção aprovar.</p>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"verMinha()\"><span class=\"icon\">list_alt</span>Acompanhar</button><button class=\"btn fill\" onclick=\"novo()\"><span class=\"icon\">add</span>Nova solicitação</button></div>\n </div>\n</section>\n\n<!-- ACOMPANHAR -->\n<section id=\"v-seg\" class=\"hide\">\n <div class=\"card\" id=\"resCard\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">pending_actions</span></span><div><h2 class=\"ct\">Pendentes por escala</h2><div class=\"cs\" id=\"resSub\">Carregando…</div></div></div><div id=\"resL\"><div class=\"empty\"><span class=\"sp\"></span></div></div></div>\n <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">list_alt</span></span><div><h2 class=\"ct\">Solicitações</h2><div class=\"cs\">Trocas solicitadas à 1ª Seção</div></div></div>\n <div class=\"r2\"><div class=\"f\"><input type=\"text\" id=\"qn\" inputmode=\"numeric\" placeholder=\" \"><label for=\"qn\">Número da solicitação (ex.: 001)</label></div><div class=\"f\"><input type=\"date\" id=\"qd\"><label for=\"qd\">Data da solicitação</label></div></div>\n <div class=\"nav\" style=\"margin-bottom:8px\"><span></span><button class=\"btn fill\" onclick=\"busca1()\"><span class=\"icon\">search</span>Buscar</button></div>\n <div id=\"qvis\" class=\"hide\"><div class=\"lbl\">Acompanhar as trocas da minha escala</div>\n  <div class=\"f cb\"><input type=\"text\" id=\"qm\" autocomplete=\"off\" oninput=\"combo('qm','sugqm')\" onfocus=\"combo('qm','sugqm')\"><label for=\"qm\">Sou o militar (cadastrado)</label><div class=\"sug hide\" id=\"sugqm\"></div></div>\n  <div class=\"mu\" style=\"margin:-6px 0 8px\">A 1ª Seção liberou o acompanhamento das trocas de algumas escalas para quem faz parte delas.</div><button class=\"btn out sm\" onclick=\"carregaRes()\"><span class=\"icon\">lock_open</span>Ver detalhes da minha escala</button></div>\n <div id=\"lseg\"></div></div>\n</section>\n\n<!-- VER ESCALA -->\n<section id=\"v-esc\" class=\"hide\">\n <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">calendar_month</span></span><div><h2 class=\"ct\">Escala do 21º GAC</h2><div class=\"cs\">Consulta rápida — quem está de serviço, por dia, por militar ou por escala</div></div></div>\n <div class=\"chips\"><button class=\"chp on\" id=\"ec-dia\" onclick=\"escModo('dia')\">Por dia</button><button class=\"chp\" id=\"ec-mil\" onclick=\"escModo('mil')\">Por militar</button><button class=\"chp\" id=\"ec-esc\" onclick=\"escModo('esc')\">Por escala</button></div>\n <div id=\"em-dia\"><div class=\"r2\"><div class=\"f\"><input type=\"date\" id=\"ed\" onchange=\"escDia()\"><label for=\"ed\">Dia</label></div><div class=\"nav\" style=\"margin:0;align-items:center;justify-content:flex-start\"><button class=\"btn out sm\" onclick=\"escHoje(0)\">Hoje</button><button class=\"btn out sm\" onclick=\"escHoje(1)\">Amanhã</button></div></div>\n  <div class=\"f\"><input type=\"search\" id=\"ef\" placeholder=\" \" oninput=\"escFiltra()\"><label for=\"ef\">Filtrar escala ou militar</label></div></div>\n <div id=\"em-mil\" class=\"hide\"><div class=\"f cb\"><input type=\"text\" id=\"em\" autocomplete=\"off\" oninput=\"combo('em','sugem')\" onfocus=\"combo('em','sugem')\"><label for=\"em\">Militar (cadastrado)</label><div class=\"sug hide\" id=\"sugem\"></div></div><div class=\"nav\" style=\"margin-top:0\"><span></span><button class=\"btn fill sm\" onclick=\"escMil()\"><span class=\"icon\">search</span>Ver serviços</button></div></div>\n <div id=\"em-esc\" class=\"hide\"><div class=\"r2\"><div class=\"f\"><select id=\"eme\" onchange=\"escMesSel()\"></select><label for=\"eme\">Mês</label></div><div class=\"f\"><select id=\"ees\" onchange=\"escBloco()\"></select><label for=\"ees\">Escala</label></div></div></div>\n <div id=\"eout\"></div>\n <div class=\"nav\"><span></span><a class=\"btn out sm\" id=\"lnk2\" target=\"_blank\" rel=\"noopener\" href=\"#\" style=\"text-decoration:none\"><span class=\"icon\">table_view</span>Abrir a planilha completa</a></div></div>\n</section>\n\n<!-- 1ª SEÇÃO -->\n<section id=\"v-aut\" class=\"hide\">\n <div class=\"card\" id=\"login\">\n  <div class=\"ch\"><span class=\"ib\"><span class=\"icon\">lock</span></span><div><h2 class=\"ct\">1ª Seção</h2><div class=\"cs\">Selecione seu nome e informe a senha</div></div></div>\n  <div class=\"f\"><select id=\"an\"></select><label for=\"an\">Militar da 1ª Seção</label></div>\n  <div class=\"f\"><input type=\"password\" id=\"pin\" autocomplete=\"current-password\"><label for=\"pin\">Senha</label></div>\n  <div class=\"nav\"><span></span><button class=\"btn fill\" onclick=\"entrar()\"><span class=\"icon\">login</span>Entrar</button></div>\n </div>\n <div id=\"painel\" class=\"hide\">\n  <div class=\"ban in\"><span class=\"icon\">badge</span><div id=\"quem\"></div></div>\n  <div class=\"chips\" id=\"sub-nav\"></div>\n  <div id=\"p-pend\">\n   <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">pending_actions</span></span><div><h2 class=\"ct\">Solicitações pendentes</h2><div class=\"cs\" id=\"psub\"></div></div></div><div id=\"lpend\"></div></div>\n   <div class=\"card\"><div class=\"ch\"><span class=\"ib\"><span class=\"icon\">history</span></span><div><h2 class=\"ct\">Autorizadas recentemente</h2><div class=\"cs\">Pode cancelar uma troca já autorizada</div></div></div><div id=\"laut\"></div></div>\n  </div>\n  <div id=\"p-rel\" class=\"hide\"></div>\n  <div id=\"p-aud\" class=\"hide\"></div>\n  <div id=\"p-cfg\" class=\"hide\"></div>\n  <div class=\"nav\"><button class=\"btn out\" onclick=\"sair()\"><span class=\"icon\">logout</span>Sair</button><button class=\"btn out\" onclick=\"subTab(S.sub)\"><span class=\"icon\">refresh</span>Atualizar</button></div>\n </div>\n</section>\n</main>\n\n<div id=\"ajuda\" class=\"hide\" style=\"position:fixed;inset:0;z-index:110;background:rgba(0,0,0,.5);display:grid;place-items:center;padding:12px\"><div class=\"card\" style=\"max-width:620px;width:100%;margin:0;max-height:92vh;display:flex;flex-direction:column;padding:0\"><div style=\"display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--olv)\"><h2 class=\"ct\" style=\"font-size:18px\">Ajuda</h2><button class=\"btn out sm\" onclick=\"fechaAjuda()\" aria-label=\"Fechar\"><span class=\"icon\">close</span></button></div><div class=\"aj\" id=\"ajC\" style=\"padding:12px 16px;overflow:auto\"></div></div></div>\n<div id=\"tour\" class=\"hide\" style=\"position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.55);display:grid;place-items:end center;padding:16px\"><div class=\"card\" style=\"max-width:440px;width:100%;margin:0 0 70px\"><div class=\"sc\" id=\"tcn\"></div><h2 class=\"ct\" id=\"tct\" style=\"margin:4px 0 6px\"></h2><p class=\"mu\" id=\"tcp\" style=\"font-size:14px;line-height:20px;margin:0 0 12px\"></p><div class=\"nav\"><button class=\"btn out sm\" onclick=\"tourFim()\">Pular</button><button class=\"btn fill sm\" id=\"tcb\" onclick=\"tourProx()\">Próximo</button></div></div></div>\n<div id=\"mdl\" class=\"hide\" style=\"position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.5);display:grid;place-items:center;padding:16px\"><div class=\"card\" style=\"max-width:440px;width:100%;margin:0\"><h2 class=\"ct\" id=\"mdT\"></h2><p class=\"mu\" id=\"mdP\" style=\"margin:6px 0 12px;font-size:13px;line-height:18px\"></p><div class=\"f\"><textarea id=\"mdI\" maxlength=\"200\" placeholder=\" \"></textarea><label id=\"mdL\" for=\"mdI\"></label></div><div class=\"nav\"><button class=\"btn out\" onclick=\"mdFecha()\">Cancelar</button><button class=\"btn err\" id=\"mdOk\">Confirmar</button></div></div></div>\n<div id=\"poster\"><div class=\"pb\"><div>Gestão de Serviços de Escalas</div><small id=\"pSub\"></small></div><h1>Troque seu serviço pelo celular</h1><div class=\"qq\" id=\"qrBig\"></div><p>Aponte a câmera para o QR Code, escolha a data e a escala, e envie a solicitação à 1ª Seção.</p><p class=\"u\" id=\"pUrl\"></p></div>\n<nav class=\"bn\"><button id=\"n-sol\" class=\"on\" onclick=\"aba('sol')\"><span class=\"icon\">swap_horiz</span>Solicitar</button><button id=\"n-seg\" onclick=\"aba('seg')\"><span class=\"icon\">list_alt</span>Acompanhar</button><button id=\"n-esc\" onclick=\"aba('esc')\"><span class=\"icon\">calendar_month</span>Ver escala</button><button id=\"n-aut\" onclick=\"aba('aut')\"><span class=\"icon\">verified_user</span>1ª Seção</button></nav>\n\n<script>\nvar $=function(i){return document.getElementById(i)};\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction run(fn,args,ok,er){var r=google.script.run.withSuccessHandler(ok).withFailureHandler(function(e){var m=(e&&e.message)||String(e);if(/Sessão expirada/.test(m)){sair(true)}er?er(e):aviso('er',esc(m))});r[fn].apply(r,args)}\nfunction aviso(t,m){var i={ok:'check_circle',er:'error',wa:'