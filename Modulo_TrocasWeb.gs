unction splashFim(){var e=$('splash');if(!e)return;e.style.transition='opacity .25s';e.style.opacity='0';setTimeout(function(){e.classList.add('hide')},260)}\nfunction splashErro(m){$('spD').classList.add('hide');$('spM').textContent='Não foi possível abrir: '+m;$('spB').classList.remove('hide')}\nfunction splashTenta(){$('spD').classList.remove('hide');$('spM').textContent='Abrindo e conferindo a escala…';$('spB').classList.add('hide');inicia()}\n\n/* ---- início */\nfunction inicia(){ $('an').innerHTML='<option value=\"\">Carregando…</option>';\n run('webInicio',[],function(r){S=Object.assign(S,{ini:r});splashFim();var c=r.cfg;$('ttl').textContent=c.titulo;$('sub').textContent=c.subtitulo;document.title=c.titulo;\n  $('biT').textContent=c.biTitulo||'Fechamento do Boletim';$('biI').querySelector('b').textContent=c.biIntegral||'—';$('biP').querySelector('b').textContent=c.biParcial||'—';$('biN').textContent=c.biNota||'';\n  $('biN').classList.toggle('hide',!c.biNota);$('aviBI').classList.toggle('hide',!(c.biIntegral||c.biParcial||c.biNota||c.biSemana));if(!c.biSemana){$('biI').classList.toggle('hide',!c.biIntegral);$('biP').classList.toggle('hide',!c.biParcial)}\n  pintaAvisos();S.t0=Date.now();biTick();if(!S.biInt)S.biInt=setInterval(biTick,30000);\n  var le=$('lnkEsc');if(c.escalaUrl){le.href=c.escalaUrl;le.classList.remove('hide')}ajIni();atualizaBadge();if(window.__TV)tvAbrir();\n  var d=$('data');d.min=r.min;d.max=r.fim;d.value='';$('dmin').textContent=c.antecedencia?'Datas a partir de '+brd(r.min)+' (antecedência mínima de '+c.antecedencia+' dia'+(c.antecedencia>1?'s':'')+').':'';\n  $('an').innerHTML='<option value=\"\">Selecione…</option>'+r.membros.map(function(m){return '<option>'+esc(m)+'</option>'}).join('');\n  var a=ls('t_an');if(a)$('an').value=a;fillEsc()},function(e){splashErro((e&&e.message)||String(e))});\n $('data').addEventListener('change',fillEsc)}\nfunction mh(t){var m=/(\\d{1,2})\\s*[h:]\\s*(\\d{2})?/i.exec(String(t||''));return m?Number(m[1])*60+Number(m[2]||0):null}\nfunction hm(x){var h=Math.floor(x/60),m=x%60;return (h?h+' h ':'')+m+' min'}\nvar DSN=['domingo','segunda','terça','quarta','quinta','sexta','sábado'],DSC=['dom','seg','ter','qua','qui','sex','sáb'];\nfunction pIso(iso){var p=String(iso).split('-');return new Date(Number(p[0]),Number(p[1])-1,Number(p[2]))}\nfunction fIso(d){return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2)}\nfunction addD(d,n){return new Date(d.getFullYear(),d.getMonth(),d.getDate()+n)}\nfunction fDM(d){return ('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)}\nfunction expTipo(d,c){var iso=fIso(d),ex=(c.biExc||[]).filter(function(x){return x.iso===iso})[0];return ex?ex.tipo:((c.biSemana||[])[d.getDay()]||'off')}\nfunction expHora(t,c){return t==='int'?c.biIntegral:(t==='par'?c.biParcial:'')}\nfunction expNome(t){return t==='int'?'integral':(t==='par'?'parcial':'sem expediente')}\nfunction prazoBI(dServ,c){for(var i=1;i<=21;i++){var d=addD(dServ,-i),t=expTipo(d,c),m=mh(expHora(t,c));if(t!=='off'&&m!=null)return {dia:d,tipo:t,hora:expHora(t,c),min:m}}return null}\nfunction proxExp(d,c){for(var i=1;i<=21;i++){var x=addD(d,i),t=expTipo(x,c);if(t!=='off'&&mh(expHora(t,c))!=null)return {dia:x,tipo:t,hora:expHora(t,c),min:mh(expHora(t,c))}}return null}\nfunction biTick(){var c=S.ini&&S.ini.cfg,b=$('biClk');if(!c||!b)return;\n if(!c.biSemana){b.classList.add('hide');return}\n var hoje=pIso(S.ini.hoje),now=S.ini.agoraMin+Math.floor((Date.now()-S.t0)/60000),tp=expTipo(hoje,c),hh=mh(expHora(tp,c)),nx=proxExp(hoje,c);\n $('biI').querySelector('small').textContent='Hoje ('+DSN[hoje.getDay()]+') · '+expNome(tp);$('biI').querySelector('b').textContent=hh!=null?expHora(tp,c):'—';\n $('biP').querySelector('small').textContent=nx?'Próximo: '+DSN[nx.dia.getDay()]+' '+fDM(nx.dia)+' · '+expNome(nx.tipo):'Próximo';$('biP').querySelector('b').textContent=nx?nx.hora:'—';\n $('biI').classList.remove('hide');$('biP').classList.remove('hide');\n var t='',w=false,cob='';\n if(nx&&hh!=null){var ini=addD(hoje,1),fim=nx.dia;cob='O BI de hoje cobre os serviços de '+DSC[ini.getDay()]+' '+fDM(ini)+(fim>ini?' a '+DSC[fim.getDay()]+' '+fDM(fim):'')+'.'}\n if(hh==null){t='Hoje não há expediente: os pedidos seguem normalmente, sem horário de fechamento.'}\n else if(hh>now){var f=hh-now;t='Faltam '+hm(f)+' para o fechamento do BI de hoje (expediente '+expNome(tp)+', '+expHora(tp,c)+').';w=f<=60}\n else{t='O BI de hoje já fechou ('+expHora(tp,c)+'): pedidos para os serviços que ele cobre exigem justificativa de extrema necessidade.';w=true}\n $('biCob').textContent=cob;$('biCob').classList.toggle('hide',!cob);\n $('biClkT').textContent=t;b.classList.toggle('w',w);b.classList.remove('hide')}\nfunction prazoTxt(){var el=$('prazoInfo'),iso=$('data').value,c=S.ini&&S.ini.cfg;if(!el)return;if(!iso||!c||!c.biSemana){el.textContent='';return}\n var p=prazoBI(pIso(iso),c);el.textContent=p?'Prazo deste serviço: BI de '+DSC[p.dia.getDay()]+' '+fDM(p.dia)+' às '+p.hora+' (expediente '+expNome(p.tipo)+').':'';}\nfunction mesDe(iso){return iso?S.ini.meses.filter(function(m){return iso>=m.ini&&iso<=m.fim})[0]:null}\nfunction fillEsc(){fillEscSel('data','esc');prazoTxt()}\nfunction aoEscala(){prefetchDia()}\nfunction fillEscSel(di,si){var iso=$(di).value,m=mesDe(iso),s=$(si),h='';\n if(!S.ini)return;\n if(!iso){s.innerHTML='<option value=\"\">Escolha primeiro a data</option>';return}\n if(!m){s.innerHTML='<option value=\"\">Data fora das escalas disponíveis</option>';return}\n h='<option value=\"\">Selecione…</option>';m.escalas.forEach(function(e,i){h+='<option value=\"'+i+'\">'+esc(e.aba.replace(/^[^ ]+ /,'')+' · '+e.titulo)+'</option>'});s.innerHTML=h}\nfunction prefetchDia(){var iso=$('data').value,m=mesDe(iso),i=$('esc').value;if(!iso||!m||i===''||iso<S.ini.min)return;var e=m.escalas[Number(i)],k=m.mes+'|'+e.tipo+'|'+e.hdr+'|'+iso;if(S.pf&&S.pf.k===k)return;\n var pf={k:k,st:0,cbs:[]};S.pf=pf;run('webDia',[m.mes,e.tipo,e.hd